{
  "name": "kaizoku",
  "version": "0.9.0",
  "packageManager": "bun@1.3.0",
  "scripts": {
    "build": "next build",
    "build:next": "next build",
    "build:clean": "./scripts/build/build-clean.sh",
    "dev": "./scripts/build/dev-integrated.sh",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "start:prod": "NODE_ENV=production bun src/server/index.ts",
    "create-admin": "node scripts/create-admin-simple.js",
    "generate": "prisma generate",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:quick": "bash scripts/ci-local.sh --skip-tests --skip-security",
    "migrate": "prisma migrate deploy && prisma generate",
    "db:reset:dev": "./scripts/database/reset-dev.sh",
    "db:reset:safe": "./scripts/database/reset-dev-safe.sh",
    "db:rollback:migrations": "./scripts/database/rollback-migrations.sh",
    "db:seed:dev": "node scripts/database/seed-dev.js",
    "db:studio": "npx prisma studio",
    "db:test:schema": "./scripts/database/test-schema-recreation.sh",
    "db:fix-account": "./scripts/database/fix-account-table.sh",
    "db:auto-repair": "./scripts/database/auto-repair.sh",
    "wanted:setup": "./scripts/setup-wanted-tables.sh",
    "wanted:seed": "node scripts/seed-wanted-data.js",
    "smart-run": "./scripts/smart-run.sh",
    "lint": "eslint src --max-warnings=10",
    "lint:fix": "eslint src --fix",
    "type-check": "node --stack-size=8192 ./node_modules/.bin/tsc --noEmit --skipLibCheck",
    "type-check:watch": "tsc --noEmit --watch --skipLibCheck",
    "type:fix:stage1": "ts-node scripts/type-fixes/stage1-fix-exports.ts",
    "type:fix:stage2": "ts-node scripts/type-fixes/stage2-consolidate-types.ts",
    "type:fix:stage3": "ts-node scripts/type-fixes/stage3-standardize-imports.ts",
    "type:fix:stage4": "ts-node scripts/type-fixes/stage4-fix-providers.ts",
    "type:fix:stage5": "ts-node scripts/type-fixes/stage5-validate.ts",
    "type:fix:validate1": "bash scripts/type-fixes/validate-stage1.sh",
    "type:fix:all": "bash scripts/type-fixes/run-all-stages.sh",
    "type:errors": "tsc --noEmit 2>&1 | grep 'error TS' | wc -l",
    "migrate:types": "tsx scripts/migrate-to-prisma-types.ts",
    "migrate:types:dry": "tsx scripts/migrate-to-prisma-types.ts --dry-run",
    "migrate:types:test": "tsx scripts/test-migration.ts",
    "migrate:async-result": "tsx scripts/migrate-to-async-result.ts",
    "migrate:async-result:dry": "tsx scripts/migrate-to-async-result.ts --dry-run",
    "migrate:async-result:verbose": "tsx scripts/migrate-to-async-result.ts --verbose",
    "migrate:provider-metadata": "tsx scripts/migrations/migrate-provider-metadata.ts",
    "rollback:provider-metadata": "tsx scripts/migrations/rollback-provider-metadata.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:fixed:ci": "jest --ci --testPathPattern='.*\\.fixed\\.test\\.(ts|tsx)$'",
    "test:api": "jest --config src/server/api/__tests__/jest.config.js",
    "test:api:watch": "jest --config src/server/api/__tests__/jest.config.js --watch",
    "test:api:coverage": "jest --config src/server/api/__tests__/jest.config.js --coverage",
    "test:prowlarr": "node scripts/test-prowlarr-api.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "install:suwayomi": "node scripts/install-suwayomi.mjs",
    "// === Security Validation Scripts ===": "",
    "security:check": "bun scripts/security/index.ts",
    "security:secrets": "bun scripts/security/scan-secrets.ts",
    "security:deps": "bun scripts/security/verify-dependencies.ts",
    "security:auth": "bun scripts/security/check-auth-patterns.ts",
    "security:drift": "bun scripts/security/check-architectural-drift.ts",
    "security:race": "bun scripts/security/check-race-conditions.ts",
    "security:logic": "bun scripts/security/check-business-logic.ts",
    "security:report": "bun scripts/security/index.ts --json --output security-report.json",
    "security:sarif": "bun scripts/security/index.ts --output security-report.sarif",
    "// === Bun Migration Scripts ===": "",
    "install:bun": "bun install",
    "install:bun:frozen": "bun install --frozen-lockfile",
    "build:bun": "bun run build",
    "test:bun": "bun test",
    "test:bun:watch": "bun test --watch",
    "type-check:bun": "bun tsc --noEmit --skipLibCheck",
    "// === Bun Hybrid Scripts ===": "",
    "clean:all": "rm -rf .next node_modules bun.lock package-lock.json pnpm-lock.yaml yarn.lock",
    "reinstall:bun": "npm run clean:all && bun install",
    "// === Keep Existing Scripts ===": "",
    "prepare": "husky"
  },
