  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Add request timestamp",
          "pm.variables.set('request_timestamp', new Date().toISOString());",
          "",
          "// Generate request ID",
          "pm.variables.set('request_id', 'req_' + Math.random().toString(36).substr(2, 9));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common tests for all requests",
          "",
          "// Check response time",
          "pm.test('Response time is less than 2000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});",
          "",
          "// Check for request ID in response",
          "if (pm.response.json().error) {",
          "    pm.test('Error response contains request ID', function () {",
          "        pm.expect(pm.response.json().error).to.have.property('requestId');",
          "    });",
          "}",
          "",
          "// Check rate limit headers",
          "pm.test('Rate limit headers are present', function () {",
          "    pm.response.to.have.header('X-RateLimit-Limit');",
          "    pm.response.to.have.header('X-RateLimit-Remaining');",
          "    pm.response.to.have.header('X-RateLimit-Reset');",
          "});",
          "",
          "// Save rate limit info",
          "if (pm.response.headers.get('X-RateLimit-Remaining')) {",
          "    const remaining = parseInt(pm.response.headers.get('X-RateLimit-Remaining'));",
          "    const reset = parseInt(pm.response.headers.get('X-RateLimit-Reset'));",
          "    const resetDate = new Date(reset * 1000);",
          "    ",
          "    console.log(`Rate limit: ${remaining} requests remaining, resets at ${resetDate.toLocaleTimeString()}`);",
          "}"
        ]
      }
    }
  ]
}