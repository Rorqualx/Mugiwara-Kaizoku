{
  "info": {
    "name": "Kaizoku API",
    "description": "Third-party API for Mugiwara-Kaizoku manga management system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "your-api-key-here",
      "type": "string"
    },
    {
      "key": "manga_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "library_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "chapter_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "download_id",
      "value": "dl_123",
      "type": "string"
    },
    {
      "key": "webhook_id",
      "value": "wh_123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Check API health status"
          },
          "response": []
        },
        {
          "name": "Get OpenAPI Spec",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/openapi.json",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "openapi.json"]
            },
            "description": "Get OpenAPI 3.0 specification"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Generate API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My API Key\",\n  \"permissions\": [\n    {\n      \"resource\": \"manga\",\n      \"actions\": [\"read\", \"write\"]\n    },\n    {\n      \"resource\": \"libraries\",\n      \"actions\": [\"read\"]\n    }\n  ],\n  \"expiresAt\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/keys",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "keys"]
            },
            "description": "Generate a new API key (requires authentication)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Manga",
      "item": [
        {
          "name": "List Manga",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/manga?page=1&limit=20&status=ACTIVE",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "manga"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page"
                },
                {
                  "key": "status",
                  "value": "ACTIVE",
                  "description": "Filter by status"
                },
                {
                  "key": "search",
                  "value": "One Piece",
                  "description": "Search by title",
                  "disabled": true
                },
                {
                  "key": "libraryId",
                  "value": "{{library_id}}",
                  "description": "Filter by library",
                  "disabled": true
                }
              ]
            },
            "description": "List all manga with pagination and filters"
          },
          "response": []
        },
        {
          "name": "Create Manga",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"One Piece\",\n  \"sourceId\": \"one-piece-anilist\",\n  \"source\": \"anilist\",\n  \"libraryId\": {{library_id}},\n  \"metadata\": {\n    \"description\": \"The legendary pirate adventure\",\n    \"authors\": [\"Eiichiro Oda\"],\n    \"genres\": [\"Adventure\", \"Comedy\", \"Drama\"],\n    \"coverUrl\": \"https://example.com/cover.jpg\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/manga",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "manga"]
            },
            "description": "Create a new manga"
          },
          "response": []
        },
        {
          "name": "Get Manga Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/manga/{{manga_id}}?include=chapters,metadata",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "manga", "{{manga_id}}"],
              "query": [
                {
                  "key": "include",
                  "value": "chapters,metadata",
                  "description": "Include related data"
                }
              ]
            },
            "description": "Get manga details by ID"
          },
          "response": []
        },
        {
          "name": "Update Manga",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\",\n  \"metadata\": {\n    \"tags\": [\"Shonen\", \"Pirates\", \"Superpowers\"]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/manga/{{manga_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "manga", "{{manga_id}}"]
            },
            "description": "Update manga information"
          },
          "response": []
        },
        {
          "name": "Delete Manga",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/manga/{{manga_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "manga", "{{manga_id}}"]
            },
            "description": "Delete a manga"
          },
          "response": []
        },
        {
          "name": "Refresh Metadata",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providers\": [\"anilist\", \"comicvine\"],\n  \"force\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/manga/{{manga_id}}/metadata/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "manga", "{{manga_id}}", "metadata", "refresh"]
            },
            "description": "Refresh manga metadata from providers"
          },
          "response": []
        }
      ]
