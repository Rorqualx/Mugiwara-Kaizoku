# Calendar Notification Configuration
# Add these settings to your .env file to enable notification channels

# Email Configuration (Choose one provider)
# SMTP Configuration
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@your-domain.com
EMAIL_TO=user@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# OR SendGrid Configuration
# EMAIL_PROVIDER=sendgrid
# EMAIL_FROM=noreply@your-domain.com
# EMAIL_TO=user@example.com
# SENDGRID_API_KEY=SG.your-sendgrid-api-key

# OR AWS SES Configuration
# EMAIL_PROVIDER=ses
# EMAIL_FROM=noreply@your-domain.com
# EMAIL_TO=user@example.com
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Discord Configuration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
DISCORD_USERNAME=Mugiwara Calendar
DISCORD_AVATAR_URL=https://your-domain.com/avatar.png
# Optional: Role ID to mention for high priority notifications
# DISCORD_MENTION_ROLE=123456789012345678

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id-or-group-id
# To get chat ID:
# 1. Send a message to your bot
# 2. Visit: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# 3. Find the chat.id in the response

# Calendar Provider Configuration (from previous setup)
# MangaDex Configuration
MANGADEX_ENABLED=true
MANGADEX_API_URL=https://api.mangadex.org
MANGADEX_THROTTLE_MS=500
MANGADEX_COVER_QUALITY=medium

# AniList Configuration
ANILIST_ENABLED=true
ANILIST_API_URL=https://graphql.anilist.co
ANILIST_THROTTLE_MS=1000
ANILIST_RATE_LIMIT=90
