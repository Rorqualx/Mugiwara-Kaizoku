# Backups directory — runtime state, never tracked.
# Supersedes earlier `backups/*.tar.gz` and `backups/*.sql` rules.
# A historical pg_dump (`backups/pre-migration-alignment-.../kaizoku-backup.dump`)
# slipped past those narrower patterns; this rule covers the whole directory.
backups/

# Temporary trash directory
.trash/

