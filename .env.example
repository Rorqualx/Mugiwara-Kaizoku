# .env.example
# Example environment file for Mugiwara-Kaizoku

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL="postgresql://kaizoku:kaizoku@localhost:5432/kaizoku"

# ============================================================================
# AUTHENTICATION & SECURITY - CRITICAL
# ============================================================================
# IMPORTANT: Generate cryptographically secure secrets for production!
# Use: openssl rand -base64 32
#
# These secrets MUST be:
# - At least 32 characters long
# - Cryptographically random (use openssl, not keyboard mashing)
# - Different for each environment (dev/staging/production)
# - Never committed to version control
# - Rotated periodically (recommended: every 90 days)
#
# Production validation will fail if secrets are too weak or contain
# placeholder text like "your-secret-here", "change-me", "example", etc.
# ============================================================================

# NextAuth.js Authentication Secret (REQUIRED)
# Used for JWT token signing and session encryption
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Legacy Auth Secret (REQUIRED for backward compatibility)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Authentication URLs
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Enable NextAuth debug mode (NEVER in production)
# Requires both AUTH_DEBUG=true AND NODE_ENV=development
# AUTH_DEBUG=true

# Application
NODE_ENV="development"
PORT=3000
KAIZOKU_PORT=3000

# Prowlarr Integration (Optional)
PROWLARR_URL="http://localhost:9696"
PROWLARR_API_KEY="your-prowlarr-api-key"

# Fix for Prowlarr API proxy test mode detection
USE_FIXED_TESTS="true"

# Other Integrations (Optional)
SUWAYOMI_URL=""
ANILIST_CLIENT_ID=""
ANILIST_CLIENT_SECRET=""

# Notification Services (Optional)
TELEGRAM_ENABLED="false"
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

# Download Clients (Optional)
TRANSMISSION_ENABLED="false"
TRANSMISSION_URL=""
TRANSMISSION_USERNAME=""
TRANSMISSION_PASSWORD=""

NZBGET_ENABLED="false"
NZBGET_URL=""
NZBGET_USERNAME=""
NZBGET_PASSWORD=""

# Logging
LOG_LEVEL="info"

# Security
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# FLARESOLVERR CONFIGURATION
# ============================================================================
# FlareSolverr provides Cloudflare bypass for scraping protected sites.
# It runs as a Python subprocess inside the app (native and Docker).
# Without it, some metadata sources (like ComicVine) may not work.
#
# The app will:
# 1. Try direct HTTP requests first
# 2. Fall back to FlareSolverr on Cloudflare blocks (403/503)
# 3. Work without FlareSolverr (with reduced scraping capability)
# ============================================================================

# Enable/disable FlareSolverr integration
FLARESOLVERR_ENABLED="true"

# FlareSolverr URL (localhost since it runs as subprocess)
# Note: In Docker, FlareSolverr runs inside the same container
FLARESOLVERR_URL="http://localhost:8191/v1"

# Request timeout in milliseconds (default: 60000 = 60 seconds)
FLARESOLVERR_TIMEOUT="60000"

# Session TTL in milliseconds (default: 1800000 = 30 minutes)
# Sessions persist cookies across requests for the same domain
FLARESOLVERR_SESSION_TTL="1800000"

# Block images, CSS, and fonts for faster scraping (default: true)
# We only need HTML content for metadata, not images
FLARESOLVERR_DISABLE_MEDIA="true"

# Wait time in seconds after challenge completion (default: 0)
# Use 1-3 seconds if pages need time to load dynamic content
FLARESOLVERR_DEFAULT_WAIT_SECS="0"

# Log level for FlareSolverr subprocess
FLARESOLVERR_LOG_LEVEL="info"

# External FlareSolverr instance (optional)
# If set, skips subprocess and uses external instance instead
# FLARESOLVERR_EXTERNAL_URL="http://192.168.1.100:8191/v1"
