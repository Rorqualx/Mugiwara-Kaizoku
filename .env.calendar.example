# Calendar Provider Configuration
# Add these settings to your .env file to enable provider integration

# MangaDex Configuration
MANGADEX_ENABLED=true
MANGADEX_API_URL=https://api.mangadex.org
# Optional: Add your MangaDex credentials for authenticated requests
# MANGADEX_CLIENT_ID=your_client_id
# MANGADEX_CLIENT_SECRET=your_client_secret
# MANGADEX_USERNAME=your_username
# MANGADEX_PASSWORD=your_password
MANGADEX_THROTTLE_MS=500
MANGADEX_COVER_QUALITY=medium

# AniList Configuration
ANILIST_ENABLED=true
ANILIST_API_URL=https://graphql.anilist.co
# Optional: Add your AniList access token for authenticated requests
# ANILIST_ACCESS_TOKEN=your_access_token
# ANILIST_CLIENT_ID=your_client_id
# ANILIST_CLIENT_SECRET=your_client_secret
ANILIST_THROTTLE_MS=1000
ANILIST_RATE_LIMIT=90
