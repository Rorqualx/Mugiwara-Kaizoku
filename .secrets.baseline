# Secrets Baseline
# This file tracks known false positives for secret scanning
# Format: file:line:pattern
#
# DO NOT add real secrets here - only false positives
# Examples:
#   src/lib/config.ts:42:Generic API Key
#   tests/fixtures/test-data.ts:15:JWT Token
#
# To regenerate this file, run:
#   npm run security:secrets --update-baseline
