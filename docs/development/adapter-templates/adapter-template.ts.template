  public async searchMangaAsync(query: string, options?: SearchOptions): Promise<AsyncResult<MangaMetadata[], Error>> {
    try {
      const resultsAsync = await this.search(query, options);
      
      if (!isSuccess(resultsAsync)) {
        return resultsAsync as AsyncResult<MangaMetadata[], Error>;
      }

      // Convert search results to MangaMetadata format
      const mangaList = resultsAsync.data.map(result => {
        const domainStatus = result.status || MangaPublicationStatus.UNKNOWN;

        // Create proper MangaMetadata objects
        return {
          title: result.title,
          alternativeTitles: result.alternativeTitles || [],
          description: result.description,
          coverImage: result.coverImage || '',
          coverUrl: result.coverImage || '',
          status: domainStatus,
          year: result.year,
          genres: result.genres || [],
          tags: result.tags || [],
          chapters: result.chapters,
          volumes: result.volumes
        } as MangaMetadata;
      });
      return createSuccessResult(mangaList);
    } catch (error) {
      this.log('Template search manga failed', error);
      return createErrorResult(this.createError(`Failed to search manga on Template API: ${error instanceof Error ? error.message : String(error)}`, error));
    }
  }

