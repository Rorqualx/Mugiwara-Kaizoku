        downloadUrl: null,
        coverImage: null,
        description: null,
        hash: null,
        mimeType: null,
        volume: null,
        filePath: null,
        fileFormat: null,
        releaseDate: null,
        isRead: false,
        createdAt: new Date(),
        updatedAt: new Date()
      }];

      // Apply filtering based on options
      let filteredChapters = [...chapters];

      // Apply offset if provided
      if (options?.offset !== undefined && options.offset > 0) {
        filteredChapters = filteredChapters.slice(options.offset);
      }

      // Apply limit if provided
      if (options?.limit !== undefined && options.limit > 0) {
        filteredChapters = filteredChapters.slice(0, options.limit);
      }

      // Apply language filter if provided
      if (options?.translatedLanguage && options.translatedLanguage.length > 0) {
        filteredChapters = filteredChapters.filter(chapter => chapter.language !== null && chapter.language !== undefined && options.translatedLanguage?.includes(chapter.language));
      }
      return createSuccessResult(filteredChapters);
    } catch (error) {
      this.log(`Template get chapters failed for manga ${mangaId}`, error);
      return createErrorResult(this.createError(`Failed to get chapters from Template API: ${error instanceof Error ? error.message : String(error)}`, error));
