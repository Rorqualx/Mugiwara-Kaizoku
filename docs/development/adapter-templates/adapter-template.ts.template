  /**
   * Updates manga metadata with information from the provider using AsyncResult pattern
   * 
   * @param mangaId - Manga database ID (string or number)
   * @returns Promise resolving to AsyncResult indicating success or failure
   */
  public async updateMangaMetadataAsync(mangaId: string | number): Promise<AsyncResult<void, Error>> {
    try {
      // Convert to number if it's a string
      const numericId = typeof mangaId === 'string' ? toNumericId(mangaId) : mangaId;

      // Find manga in the database
      const manga = await this.prisma.manga.findUnique({
        where: {
          id: numericId
        },
        include: {
          metadata: true
        }
      });

      // Check if manga exists and has a source ID
      if (!manga || !manga.metadata?.sourceId) {
        return createErrorResult(new Error('Manga not found or missing source ID'));
      }

      // Get updated metadata using AsyncResult pattern
      const mangaDataResult = await this.getMangaByIdAsync(manga.metadata.sourceId);

      // Handle the AsyncResult properly
      if (!isSuccess(mangaDataResult)) {
        return createErrorResult(isError(mangaDataResult) ? new Error(`Failed to get manga data: ${mangaDataResult.error.message}`) : new Error('Failed to get manga data - unknown state'));
      }

      // Extract data from successful result
      const mangaData = mangaDataResult.data;

      // Safely determine the status with proper type handling
      let status: MangaPublicationStatus;
      if (mangaData.status) {
        if (typeof mangaData.status === 'string') {
          // Convert string status to domain status
          status = this.mapStatus(mangaData.status);
        } else {
          // It's already a MangaStatus enum value
          status = mangaData.status as MangaPublicationStatus;
        }
      } else {
        status = MangaPublicationStatus.UNKNOWN;
      }

      // Create a properly typed update input
      const updateData: Prisma.MetadataUpdateInput = {
        cover: mangaData.coverUrl ?? '/cover-not-found.jpg',
        summary: mangaData.description ?? null,
        genres: Array.isArray(mangaData.genres) ? mangaData.genres : [],
        authors: Array.isArray(mangaData.authors) ? mangaData.authors : [],
        status: status as MangaPublicationStatus,
        // Cast to correct enum type
        tags: Array.isArray(mangaData.tags) ? mangaData.tags : [],
        lastFetch: new Date()
      };

      // Update metadata in the database
      await this.prisma.metadata.update({
        where: {
          id: manga.metadata.id
        },
        data: updateData
      });
      return createSuccessResult(undefined);
    } catch (error) {
      this.log('Failed to update manga metadata', error);
      return createErrorResult(this.createError(`Failed to update manga metadata: ${error instanceof Error ? error.message : String(error)}`, error));
    }
  }

