  timestamp      DateTime                @default(now())
  healthy        Boolean
  responseTimeMs Int?
  version        String?
  sessionCount   Int                     @default(0)
  requestType    FlareSolverrRequestType @default(HEALTH_CHECK)
  success        Boolean
  errorMessage   String?
  hour           DateTime                @db.Timestamptz(6)

  @@index([timestamp])
  @@index([hour])
  @@index([healthy])
}

model FlareSolverrMetricsHourly {
