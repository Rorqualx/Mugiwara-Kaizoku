model RateLimitState {
  id               String    @id @default(dbgenerated("gen_random_uuid()"))
  /// Provider name (e.g., 'mangadex', 'anilist', 'calendar-sync')
  provider         String
  /// Rate limit bucket key (e.g., 'api-requests', 'search-requests')
  bucket           String
  /// Current token count
  tokens           Int       @default(0)
  /// Maximum tokens allowed in bucket
  maxTokens        Int
  /// Tokens refilled per interval
  refillRate       Int
  /// Refill interval in milliseconds
  refillIntervalMs Int
  /// Timestamp of last refill
  lastRefillAt     DateTime  @default(now())
  /// Timestamp of last request
  lastRequestAt    DateTime  @default(now())
  /// Whether rate limit is currently exceeded
  isLimited        Boolean   @default(false)
  /// When the rate limit will reset (if limited)
  resetsAt         DateTime?
  /// Additional metadata
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([provider, bucket])
  @@index([provider])
  @@index([isLimited])
  @@index([resetsAt])
}

