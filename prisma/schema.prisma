// ============================================================================
// Cache, WebSocket & rate-limit infrastructure tables
// ============================================================================
// These tables back the realtime/WebSocket layer, multi-tier cache, rate
// limiting, and the volatile job queue (jobs_volatile, separate from the
// partitioned `jobs` model above). They're created/maintained outside the
// normal Prisma migration flow (raw-SQL setup scripts in
// src/server/services/realtime/, cache layers, etc.) but modeled here so
// `prisma generate` produces typed clients and `prisma migrate diff` reports
// a clean DB-vs-schema state.

model cache_unified {
  cache_key        String    @id
  cache_value      Json
  data_type        String?
  namespace        String?   @default("default")
  expires_at       DateTime? @db.Timestamptz(6)
  access_count     Int?      @default(0)
  access_frequency Float?    @default(1.0) @db.Real
  last_accessed_at DateTime? @default(now()) @db.Timestamptz(6)
  tags             String[]  @default([])
  size_bytes       Int?      @default(0)
  metadata         Json?     @default("{}")
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)

  @@index([expires_at], map: "idx_cache_unified_expires", where: raw("(expires_at IS NOT NULL)"))
  @@index([cache_value], map: "idx_cache_unified_gin", type: Gin)
  @@index([cache_key], map: "idx_cache_unified_hash", type: Hash)
  @@index([access_frequency, last_accessed_at], map: "idx_cache_unified_lru")
  @@index([namespace], map: "idx_cache_unified_namespace")
  @@index([tags], map: "idx_cache_unified_tags", type: Gin)
}

model channel_subscriptions {
  connection_id         String                @db.Uuid
  channel               String
  subscribed_at         DateTime?             @default(now()) @db.Timestamptz(6)
  filters               Json?                 @default("{}")
  websocket_connections websocket_connections @relation(fields: [connection_id], references: [connection_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([connection_id, channel])
  @@index([channel], map: "idx_chan_sub_channel")
  @@index([connection_id], map: "idx_chan_sub_conn")
}

model hot_data_cache {
  entity_type   String
  entity_id     String
  cache_data    Json
  hit_count     Int?      @default(0)
  heat_score    Float?    @default(1.0) @db.Real
  last_accessed DateTime? @default(now()) @db.Timestamptz(6)
  expires_at    DateTime? @db.Timestamptz(6)
  tags          String[]  @default([])

  @@id([entity_type, entity_id])
  @@index([last_accessed], map: "idx_hot_data_accessed")
  @@index([expires_at], map: "idx_hot_data_expires", where: raw("(expires_at IS NOT NULL)"))
  @@index([heat_score(sort: Desc)], map: "idx_hot_data_heat")
}

model jobs_volatile {
  id                 BigInt    @id @default(autoincrement())
  queue_name         String    @default("volatile")
  job_type           String
  priority           Int?      @default(50)
  payload            Json?     @default("{}")
  result             Json?
  metadata           Json?     @default("{}")
  status             String?   @default("PENDING")
  progress           Int?      @default(0)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  scheduled_for      DateTime? @default(now()) @db.Timestamptz(6)
  started_at         DateTime? @db.Timestamptz(6)
  completed_at       DateTime? @db.Timestamptz(6)
  attempt_count      Int?      @default(0)
  max_attempts       Int?      @default(1)
  worker_id          String?
  lease_expires_at   DateTime? @db.Timestamptz(6)
  processing_time_ms Int?
  wait_time_ms       Int?

  @@index([queue_name, priority(sort: Desc), scheduled_for], map: "idx_jobs_volatile_queue")
  @@index([status, queue_name], map: "idx_jobs_volatile_status")
  @@index([worker_id, lease_expires_at], map: "idx_jobs_volatile_worker")
}

model message_routing {
  id                BigInt    @id @default(autoincrement())
  target_server     String
  channel           String
  payload           Json
  published_at      DateTime? @default(now()) @db.Timestamptz(6)
  delivered         Boolean?  @default(false)
  delivery_attempts Int?      @default(0)
  last_attempt_at   DateTime? @db.Timestamptz(6)
  expires_at        DateTime? @default(dbgenerated("(now() + '00:05:00'::interval)")) @db.Timestamptz(6)

  @@index([channel], map: "idx_msg_routing_channel")
  @@index([expires_at], map: "idx_msg_routing_expires", where: raw("(NOT delivered)"))
  @@index([target_server, delivered], map: "idx_msg_routing_pending", where: raw("((NOT delivered) AND (delivery_attempts < 3))"))
}

model presence_tracking {
  channel               String
  user_id               String
  connection_id         String?                @db.Uuid
  status                String
  last_seen             DateTime?              @default(now()) @db.Timestamptz(6)
  metadata              Json?                  @default("{}")
  websocket_connections websocket_connections? @relation(fields: [connection_id], references: [connection_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([channel, user_id])
  @@index([channel], map: "idx_presence_channel", where: raw("(status <> 'offline'::text)"))
  @@index([last_seen], map: "idx_presence_last_seen")
  @@index([user_id], map: "idx_presence_user")
}

model rate_limits {
  limit_key    String   @id
  count        Int      @default(0)
  window_start DateTime @default(now()) @db.Timestamptz(6)
  expires_at   DateTime @default(dbgenerated("(now() + '00:01:00'::interval)")) @db.Timestamptz(6)
}

model sessions_cache {
  session_id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String?
  session_data          Json                    @default("{}")
  ip_address            String?                 @db.Inet
  user_agent            String?
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  expires_at            DateTime                @db.Timestamptz(6)
  last_accessed         DateTime?               @default(now()) @db.Timestamptz(6)
  access_count          Int?                    @default(1)
  metadata              Json?                   @default("{}")
  websocket_connections websocket_connections[]

  @@index([last_accessed], map: "idx_sessions_accessed")
  @@index([expires_at], map: "idx_sessions_expires")
  @@index([user_id], map: "idx_sessions_user_id")
}

model websocket_connections {
  connection_id         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  server_id             String
  session_id            String?                 @db.Uuid
  user_id               String?
  connected_at          DateTime?               @default(now()) @db.Timestamptz(6)
  last_activity         DateTime?               @default(now()) @db.Timestamptz(6)
  client_metadata       Json?                   @default("{}")
  channel_subscriptions channel_subscriptions[]
  presence_tracking     presence_tracking[]
  sessions_cache        sessions_cache?         @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_session")

  @@index([last_activity], map: "idx_ws_conn_activity")
  @@index([session_id], map: "idx_ws_conn_session")
  @@index([user_id], map: "idx_ws_conn_user", where: raw("(user_id IS NOT NULL)"))
}

model websocket_servers {
  server_id        String    @id
  hostname         String
  port             Int
  started_at       DateTime? @default(now()) @db.Timestamptz(6)
  last_heartbeat   DateTime? @default(now()) @db.Timestamptz(6)
  connection_count Int?      @default(0)
  status           String    @default("active")
  metadata         Json?     @default("{}")

  @@index([last_heartbeat], map: "idx_ws_server_heartbeat", where: raw("(status = 'active'::text)"))
  @@index([status], map: "idx_ws_server_status")
}

/// iter-D1: Live-dispatch claim-vs-fulfilled telemetry. One row per
/// Prowlarr release picked by dispatchProwlarrManual / maybeTriggerProwlarr.
/// Resolved later by prowlarr-handler completion to record which of the
/// claimed chapters actually landed on disk. Used to drive the coverage-
/// parser improvement loop's per-iter accuracy metric.
model ProwlarrCoverageAttempt {
  id                  BigInt    @id @default(autoincrement())
  mangaId             Int
  releaseTitle        String
  indexer             String?
  /// Volume numbers the release-title parser claimed
  claimedVolumes      Json      @default("[]")
  /// Chapter numbers the release-title parser claimed
  claimedChapters     Json      @default("[]")
  /// Chapter ids included in the dispatch scope at claim time
  scopedChapterIds    Json      @default("[]")
  /// Chapter ids that actually transitioned to COMPLETED for this attempt
  fulfilledChapterIds Json      @default("[]")
  /// 'claimed' = pending resolution; 'fulfilled' = all claimed landed;
  /// 'partial' = some landed; 'empty' = none landed; 'orphan' = no completion match
  status              String    @default("claimed")
  /// (fulfilled ∩ claimed).size / claimed.size  — set on resolution
  claimAccuracy       Float?
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?

  @@index([mangaId, createdAt])
  @@index([status, createdAt])
}

/// iter-EX: Per-chapter per-source dispatch history. One row per attempt
/// to dispatch a specific chapter through a specific source. The dispatch
/// pipeline reads recent failures to skip sources that have already failed
/// for a chapter, and the UI can surface "all sources exhausted" once
/// every known source has been tried+failed.
model ChapterDispatchAttempt {
  id            BigInt    @id @default(autoincrement())
  chapterId     Int
  mangaId       Int
  /// 'mangadex' | 'suwayomi' | 'getcomics' | 'prowlarr'
  source        String
  releaseTitle  String?
  indexer       String?
  jobId         BigInt?
  /// 'dispatched' = pending resolution; 'completed' = file landed;
  /// 'failed' = chapter went back to PENDING or ERROR; 'orphan' = no transition
  /// observed within the 24h window
  outcome       String    @default("dispatched")
  failureReason String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([chapterId, createdAt])
  @@index([mangaId, source, createdAt])
  @@index([outcome, createdAt])
}

/// iter-CDB-0.2: Per-host download telemetry. One row per attempt by the
/// GetComics handler to stream a file from a file host (MediaFire, MEGA,
/// GoFile, etc.). Drives the per-iter scorecard for the comic-host
/// download improvement loop and surfaces host-level failure modes.
model HostDownloadAttempt {
  id           BigInt   @id @default(autoincrement())
  chapterId    Int?
  jobId        BigInt?
  /// 'mediafire' | 'mega' | 'gofile' | 'dropapk' | 'direct' | 'userscloud' | ...
  host         String
  /// Resolved binary URL the handler tried to fetch.
  url          String
  /// 'success' = file landed; 'failed' = generic; 'cloudflare_blocked' = challenge persisted;
  /// 'expired' = link no longer valid; 'quota' = host bandwidth exhausted; 'parse_failed' = couldn't extract direct URL.
  outcome      String
  durationMs   Int?
  fileBytes    Int?
  retries      Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([host, createdAt])
  @@index([outcome, createdAt])
}

/// Phase 1.5: Per-manga per-selector-pass attempt log. One row per
/// runEnrichmentPipeline that touched the Metadata row through the
/// cross-source consensus selector. Records what the selector picked,
/// what dissented, and the per-field confidence — drives the selector-loop
/// scorecard and the sticky-binding hook (Phase 3) for cross-version drift.
model MetadataSelectionAttempt {
  id              BigInt    @id @default(autoincrement())
  mangaId         Int
  /// Selector version — bumped when authority weights or selector rules
  /// change. Lets historical rows be compared against current behaviour
  /// without re-running enrichment.
  selectorVersion String    @default("1.0.0")
  /// Field-level picks: { [field]: { winner, winnerConfidence, dissenterCount } }.
  /// The full alternatives live in Metadata.fieldAlternatives — this is the
  /// lightweight per-attempt summary.
  selections      Json      @default("{}")
  /// Fields the guard refused (numeric drift > tolerance against anchor).
  /// Array of field names.
  refusedFields   Json      @default("[]")
  /// Shadow-mode only: { [field]: { newValue, oldValue, newProvider, oldProvider } }
  /// for picks that would have changed vs the legacy Object.assign chain.
  /// Null after Phase 1.5 cutover deletes the legacy path.
  shadowDeltas    Json?
  createdAt       DateTime  @default(now())

  @@index([mangaId, createdAt])
  @@index([selectorVersion, createdAt])
}
