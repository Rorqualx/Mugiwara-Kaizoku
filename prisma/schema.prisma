generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Backup {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  createdAt DateTime        @default(now())
  size      BigInt
  path      String
  status    BackupStatus    @default(PENDING)
  type      BackupType      @default(MANUAL)
  contents  BackupContent[]
  items     BackupItem[]
  hash      String?
  notes     String?

  @@index([createdAt])
  @@index([status])
  @@index([type])
  @@index([status, createdAt])
  @@index([hash])
}

model BackupItem {
  id        Int      @id @default(autoincrement())
  backupId  Int
  itemType  String // e.g., "database", "manga_files", "config", "metadata"
  itemPath  String // Path or identifier of the backed up item
  itemSize  BigInt // Size in bytes
  checksum  String? // Optional hash/checksum for verification
  createdAt DateTime @default(now())
  Backup    Backup   @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([backupId])
  @@index([itemType])
  @@index([checksum])
}

model Chapter {
  id                Int                      @id @default(autoincrement())
  fileName          String                   @db.VarChar(255)
  index             Int
  size              Int                      @default(0)
  mangaId           Int
  title             String                   @db.VarChar(255)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime
  downloadStatus    ChapterStatus            @default(PENDING)
  downloadUrl       String?
  hash              String?                  @unique
  mimeType          String?                  @db.VarChar(100)
  pageCount         Int?
  resolutionWidth   Int?
  resolutionHeight  Int?
  resolutionLabel   String?
  language          String?
  alternativeTitles String[]                 @default([])
  chapterNumber     Float?
  coverImage        String?
  description       String?
  fileFormat        String?                  @db.VarChar(10)
  filePath          String?                  @db.VarChar(500)
  isRead            Boolean                  @default(false)
  monitored         Boolean                  @default(false)
  number            Float?
  packDownloadId    BigInt?
  pages             Int?
  releaseDate       DateTime?
  volume            Int?
  volumeId          Int?
  mangadexId        String?                  @unique // MangaDex chapter UUID
  suwayomiChapterId String?                  @unique // Suwayomi-internal chapter id (numeric, stored as string)
  pageCountAttempts Int                      @default(0) // ghost-recount retry counter; rows >=3 are skipped permanently
  Manga             Manga                    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  Volume            Volume?                  @relation(fields: [volumeId], references: [id], onDelete: SetNull)
  PackDownload      PackDownload?            @relation(fields: [packDownloadId], references: [id], onDelete: SetNull)
  CalendarEvent     CalendarEvent[]
  jobs              jobs[]
  ReadingProgress   ReadingProgress[]
  ReaderBookmark    ReaderBookmark[]
  ReadingHistory    ReadingHistory[]
  WantedItem        WantedItem[]
  DownloadHistory   DownloadHistory[]
  scanlationGroups  ChapterScanlationGroup[]
  chapterFiles      ChapterFile[]
  NativeDownload    NativeDownload[]

  // Audio Player Relations
  AudioPlaybackProgress AudioPlaybackProgress[]
  AudioBookmark         AudioBookmark[]
  ListeningHistory      ListeningHistory[]

  @@unique([mangaId, chapterNumber], map: "Chapter_mangaId_chapterNumber_unique", where: raw("(\"chapterNumber\" IS NOT NULL)"))
  // Phantom-row guard lives in prisma/migrations/chapter_one_null_per_volume.sql (applied via psql,
  // not Prisma — `db push` doesn't recognize the partial WHERE clause and flags it as data loss).
  @@unique([mangaId, index])
  @@index([createdAt])
  @@index([downloadStatus])
  @@index([packDownloadId])
  @@index([volumeId])
  @@index([mangadexId])
  @@index([suwayomiChapterId])
  @@index([mangaId, chapterNumber])
  @@index([mangaId, volume])
}

model ChapterFile {
  id         Int      @id @default(autoincrement())
  chapterId  Int
  filePath   String   @db.VarChar(500)
  fileName   String   @db.VarChar(255)
  fileSize   Int      @default(0)
  isActive   Boolean  @default(false)
  sourceType String   @db.VarChar(20)
  pageStart  Int?
  pageEnd    Int?
  pageCount  Int?
  importedAt DateTime @default(now())

  Chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, filePath])
  @@index([chapterId])
  @@index([filePath])
  @@index([chapterId, isActive])
}

model Library {
  id         Int       @id @default(autoincrement())
  name       String
  path       String
  createdAt  DateTime  @default(now())
  lastScanAt DateTime?
  Manga      Manga[]
}

model Manga {
  id                   Int                    @id @default(autoincrement())
  title                String                 @unique
  source               String
  libraryId            Int
  metadataId           Int?                   @unique
  lastChecked          DateTime?
  libraryPath          String?
  mangaTitle           String?
  createdAt            DateTime               @default(now())
  errorMessage         String?
  lastErrorAt          DateTime?
  lastSyncAt           DateTime?
  summary              String?
  syncCount            Int                    @default(0)
  updatedAt            DateTime
  searchProvider       String                 @default("anilist")
  providerMetadata     Json?
  monitoringConfig     Json?
  suwayomiPluginConfig Json? // Per-manga Suwayomi library-source plugin config
  fileStatus           MangaFileStatus        @default(PENDING)
  libraryStatus        MangaLibraryStatus     @default(ACTIVE)
  metadataConfidence   Float?
  mlCorrected          Boolean?               @default(false)
  publicationStatus    MangaPublicationStatus @default(UNKNOWN)
  rawProviderData      Json?
  selectedSourceId     String?
  sourceId             String?
  mediaType            MediaType              @default(MANGA)
  Chapter              Chapter[]
  Library              Library                @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  Metadata             Metadata?              @relation(fields: [metadataId], references: [id])
  PackDownload         PackDownload[]
  ReleaseBlocklist     ReleaseBlocklist[]
  CalendarEvent        CalendarEvent[]
  ReleaseSchedule      ReleaseSchedule[]
  ReleaseHistory       ReleaseHistory[]
  jobs                 jobs[]
  ReadingProgress      ReadingProgress[]
  ReaderBookmark       ReaderBookmark[]
  ReadingHistory       ReadingHistory[]
  WantedItem           WantedItem[]
  DownloadHistory      DownloadHistory[]
  autoDownloadRule     AutoDownloadRule?
  BookmarkedVolume     BookmarkedVolume[]
  BookmarkedManga      BookmarkedManga[]
  Volume               Volume[]
  VolumeProgress       VolumeProgress[]
  scanlationGroups     MangaScanlationGroup[]

  // Audio Player Relations
  AudioPlaybackProgress AudioPlaybackProgress[]
  AudioBookmark         AudioBookmark[]
  ListeningHistory      ListeningHistory[]

  // Pipeline Relations
  PendingRelease PendingRelease[]

  // Phase 1: manga-to-manga relations (prequel/sequel/side-story/etc.)
  mangaRelationsFrom MangaRelation[] @relation("MangaRelationFrom")
  mangaRelationsTo   MangaRelation[] @relation("MangaRelationTo")

  @@unique([libraryId, libraryPath])
  @@index([createdAt])
  @@index([lastChecked])
  @@index([searchProvider])
  @@index([mediaType, createdAt])
}

/// Phase 1: directed relation between manga (prequel/sequel/side-story/etc.).
/// `toMangaId` is nullable so we can persist relations whose target isn't in
/// the library yet; the inverse-resolver on Manga.create back-fills it when
/// the target manga is later imported. `targetTitle` is denormalized so the
/// chip renders correctly even if the target is later deleted. Sourced from
/// AniList in Phase 1 (`externalSource = 'anilist'`); MangaDex relationships
/// could supplement in a later phase via additional rows per provider.
model MangaRelation {
  id             Int                       @id @default(autoincrement())
  fromMangaId    Int
  toMangaId      Int?
  externalSource String
  externalToId   String
  targetTitle    String
  targetMedium   MangaRelationTargetMedium
  relationType   MangaRelationType
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  fromManga Manga  @relation("MangaRelationFrom", fields: [fromMangaId], references: [id], onDelete: Cascade)
  toManga   Manga? @relation("MangaRelationTo", fields: [toMangaId], references: [id], onDelete: SetNull)

  @@unique([fromMangaId, externalSource, externalToId, relationType])
  @@index([fromMangaId])
  @@index([toMangaId])
  @@index([externalSource, externalToId])
}

model Metadata {
  id                     Int                    @id @default(autoincrement())
  coverExtraLarge        String?
  coverLarge             String?
  coverMedium            String?
  summary                String?
  genres                 String[]               @default([])
  authors                String[]               @default([])
  tags                   String[]               @default([])
  themes                 String[]               @default([])
  startDate              DateTime?
  endDate                DateTime?
  synonyms               String[]               @default([])
  urls                   String[]               @default([])
  createdAt              DateTime               @default(now())
  updatedAt              DateTime?
  cover                  String                 @default("/cover-not-found.jpg")
  lastFetch              DateTime?
  source                 String?                @db.VarChar(100)
  sourceId               String?                @db.VarChar(100)
  chapters               Int?
  volumes                Int?
  artists                String[]               @default([])
  averageScore           Float?
  bannerImage            String?
  countryOfOrigin        String?
  externalLinks          Json?
  format                 String?
  idMal                  Int?
  popularity             Int?
  // Phase 1: publishers[] replaces single publisher; multi-publisher (JP licensor + EN licensor) is the actual data shape from MU.
  publishers             String[]               @default([])
  // Phase 1: rating widened to JSON {value, scoredBy?, rank?, source?} aggregating AL/MAL/MU/Kitsu signals.
  rating                 Json?
  status                 MangaPublicationStatus @default(UNKNOWN)
  galleryImages          String[]               @default([])
  // Phase 1: content rating + publication demographic from MangaDex.
  contentRating          String?
  publicationDemographic String?
  // Phase 1.5: per-field dissenting candidates from the cross-source consensus
  // selector. Shape: { [field]: [{ provider, value, confidence }, ...] }.
  // Winner lives in the canonical column; this column carries the candidates
  // that lost. Read by the UI provenance badge (Phase 4) and by the selector
  // loop scorecard. Null when the row predates Phase 1.5 or no field had >1
  // candidate.
  fieldAlternatives      Json?
  Manga                  Manga?

  @@index([createdAt])
  @@index([source, sourceId])
}

model ParseFailureLog {
  id          String   @id @default(cuid())
  source      String
  url         String
  stage       String
  mangaId     Int?
  reason      String
  contextJson Json?
  createdAt   DateTime @default(now())

  @@index([source, createdAt])
  @@index([mangaId])
  @@index([stage, createdAt])
}

// ============================================================================
// Volume Models - Multi-Tiered Volume Data Storage
// ============================================================================

model Volume {
  id               Int     @id @default(autoincrement())
  mangaId          Int
  number           Int
  title            String? @db.VarChar(500)
  subtitle         String? @db.VarChar(500)
  alternativeTitle String? @db.VarChar(500)
  description      String?
  summary          String?

  // Publication details
  isbn        String?      @db.VarChar(20)
  isbn13      String?      @db.VarChar(20)
  publisher   String?      @db.VarChar(255)
  pageCount   Int?
  format      VolumeFormat @default(TANKOBON)
  releaseDate DateTime?
  coverImage  String?      @db.VarChar(1000)

  // Chapter range
  chapterStart  Float?
  chapterEnd    Float?
  totalChapters Int?

  // Source tracking
  source         String?   @db.VarChar(50)
  sourceId       String?   @db.VarChar(100)
  sourceUrl      String?   @db.VarChar(1000)
  fetchedAt      DateTime?
  lastEnriched   DateTime?
  enrichmentTier Int?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  manga      Manga              @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapters   Chapter[]
  creators   VolumeCreator[]
  characters VolumeCharacter[]
  themes     VolumeTheme[]
  genres     VolumeGenre[]
  storyArcs  VolumeStoryArc[]
  progress   VolumeProgress[]
  bookmarks  BookmarkedVolume[]

  @@unique([mangaId, number])
  @@index([mangaId])
  @@index([releaseDate])
  @@index([source, sourceId])
  @@index([isbn])
  @@index([isbn13])
}

model VolumeCreator {
  id       Int         @id @default(autoincrement())
  volumeId Int
  name     String      @db.VarChar(255)
  role     CreatorRole
  volume   Volume      @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@unique([volumeId, name, role])
  @@index([volumeId])
  @@index([name])
  @@index([role])
}

model VolumeCharacter {
  id       Int     @id @default(autoincrement())
  volumeId Int
  name     String  @db.VarChar(255)
  isMain   Boolean @default(false)
  volume   Volume  @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@unique([volumeId, name])
  @@index([volumeId])
  @@index([name])
}

model VolumeTheme {
  id       Int    @id @default(autoincrement())
  volumeId Int
  theme    String @db.VarChar(100)
  volume   Volume @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@unique([volumeId, theme])
  @@index([volumeId])
  @@index([theme])
}

model VolumeGenre {
  id       Int    @id @default(autoincrement())
  volumeId Int
  genre    String @db.VarChar(100)
  volume   Volume @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@unique([volumeId, genre])
  @@index([volumeId])
  @@index([genre])
}

model VolumeStoryArc {
  id       Int    @id @default(autoincrement())
  volumeId Int
  arcName  String @db.VarChar(255)
  arcOrder Int?
  volume   Volume @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@unique([volumeId, arcName])
  @@index([volumeId])
  @@index([arcName])
}

model VolumeProgress {
  id       Int    @id @default(autoincrement())
  userId   String
  mangaId  Int
  volumeId Int

  // Progress tracking
  chaptersRead    Int       @default(0)
  totalChapters   Int
  percentComplete Float     @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  lastReadAt      DateTime  @default(now())

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga  Manga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  volume Volume @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId, volumeId])
  @@index([userId])
  @@index([mangaId])
  @@index([volumeId])
  @@index([lastReadAt])
}

model Notification {
  id               Int                   @id @default(autoincrement())
  userId           String
  type             NotificationEventType
  severity         NotificationSeverity  @default(INFO)
  title            String
  message          String
  read             Boolean               @default(false)
  createdAt        DateTime              @default(now())
  readAt           DateTime?
  relatedMangaId   Int?
  relatedChapterId Int?
  relatedJobId     BigInt?
  actionUrl        String?
  metadata         Json?
  User             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([type])
  @@index([severity])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ParserCache {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  namespace      String
  key            String
  data           Json
  compressed     Boolean   @default(false)
  size           Int       @default(0)
  metadata       Json?
  hits           Int       @default(0)
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  lastAccessedAt DateTime?

  @@unique([namespace, key])
  @@index([expiresAt])
  @@index([lastAccessedAt])
  @@index([namespace])
  @@index([size])
}

model Session {
  id           String   @id
  userId       String
  expires      DateTime
  sessionToken String
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemEvent {
  id                String   @id
  timestamp         DateTime @default(now())
  type              String
  source            String
  level             String
  message           String
  details           Json?
  relatedEntityId   String?
  relatedEntityType String?

  @@index([level])
  @@index([relatedEntityId, relatedEntityType])
  @@index([source])
  @@index([timestamp])
  @@index([type])
}

model User {
  id               String             @id
  userName         String             @unique
  email            String             @unique
  hashedPassword   String
  avatar           String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  role             UserRole           @default(USER)
  emailVerified    DateTime?
  image            String?
  name             String?
  lastLogin        DateTime?
  Account          Account[]
  Session          Session[]
  Notification     Notification[]
  ReadingProgress  ReadingProgress[]
  ReadingAnalytics ReadingAnalytics[]
  ReaderBookmark   ReaderBookmark[]
  ReaderSettings   ReaderSettings?
  ReadingHistory   ReadingHistory[]
  ApiKey           ApiKey[]
  Webhook          Webhook[]
  BookmarkedVolume BookmarkedVolume[]
  BookmarkedManga  BookmarkedManga[]
  VolumeProgress   VolumeProgress[]

  // Audio Player Relations
  AudioPlaybackProgress AudioPlaybackProgress[]
  AudioBookmark         AudioBookmark[]
  AudioPlayerSettings   AudioPlayerSettings?
  ListeningHistory      ListeningHistory[]
  ListeningAnalytics    ListeningAnalytics[]

  // ML Annotation Relations
  AnnotatedPage     AnnotatedPage[]
  AnnotationSession AnnotationSession[]

  NotificationPreference NotificationPreference[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Per-user opt-in/opt-out for a (NotificationEventType × channel) pair.
/// Channels: 'bell' | 'email' | 'discord' | 'slack' | 'telegram' | 'webhook'.
/// Absence of a row means "use the default" — written defaults live in
/// notification-preferences.ts. Writing `enabled: false` is an explicit opt-out.
model NotificationPreference {
  id        Int                   @id @default(autoincrement())
  userId    String
  eventType NotificationEventType
  channel   String
  enabled   Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime               @updatedAt
  User      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
  @@index([userId])
}

// ============================================================================
// Reader Models - Native Manga Reader Functionality
// ============================================================================

model ReadingProgress {
  id          Int       @id @default(autoincrement())
  userId      String
  mangaId     Int
  chapterId   Int
  currentPage Int
  totalPages  Int
  lastReadAt  DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga   Manga   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId, chapterId])
  @@index([userId])
  @@index([mangaId])
  @@index([lastReadAt])
}

model ReadingAnalytics {
  id                Int      @id @default(autoincrement())
  userId            String
  date              DateTime @db.Date
  pagesRead         Int      @default(0)
  chaptersCompleted Int      @default(0)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model ReaderBookmark {
  id         Int      @id @default(autoincrement())
  userId     String
  mangaId    Int
  chapterId  Int
  pageNumber Int
  note       String?
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga   Manga   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mangaId])
  @@index([chapterId])
}

model ReaderSettings {
  userId           String   @id
  readingMode      String   @default("single")
  readingDirection String   @default("rtl")
  backgroundColor  String   @default("#000000")
  fitMode          String   @default("fit-width")
  showToolbar      Boolean  @default(true)
  preloadPages     Int      @default(3)
  doublePageOffset Boolean  @default(false)
  brightness       Float    @default(1.0)
  contrast         Float    @default(1.0)
  enableGestures   Boolean  @default(true)
  enableKeyboard   Boolean  @default(true)
  clickNavigation  Boolean  @default(true)
  smoothScrolling  Boolean  @default(true)
  panelDetection   Boolean  @default(false)
  ocrEnabled       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReadingHistory {
  id        Int      @id @default(autoincrement())
  userId    String
  mangaId   Int
  chapterId Int
  pagesRead Int
  totalTime Int // in seconds
  startedAt DateTime @default(now())
  endedAt   DateTime

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga   Manga   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mangaId])
  @@index([startedAt])
}

// ============================================================================
// Audio Player Models - Native Audiobook Player Functionality
// ============================================================================

model AudioPlaybackProgress {
  id            Int       @id @default(autoincrement())
  userId        String
  mangaId       Int
  chapterId     Int
  currentTime   Float // Current playback position in seconds
  duration      Float // Total duration in seconds
  playbackSpeed Float     @default(1.0)
  volume        Float     @default(1.0)
  lastPlayedAt  DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga   Manga   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId, chapterId])
  @@index([userId])
  @@index([mangaId])
  @@index([lastPlayedAt])
}

model AudioBookmark {
  id        Int      @id @default(autoincrement())
  userId    String
  mangaId   Int
  chapterId Int
  timestamp Float // Position in seconds
  note      String?
  label     String?  @db.VarChar(100) // Optional short label
  color     String?  @db.VarChar(7) // Hex color for visual distinction
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga   Manga   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mangaId])
  @@index([chapterId])
}

model AudioPlayerSettings {
  userId               String   @id
  defaultPlaybackSpeed Float    @default(1.0)
  defaultSkipForward   Int      @default(30) // seconds
  defaultSkipBackward  Int      @default(10) // seconds
  sleepTimerDefault    Int? // default sleep timer in minutes
  rememberPosition     Boolean  @default(true)
  autoPlayNext         Boolean  @default(true)
  showRemainingTime    Boolean  @default(false)
  hapticFeedback       Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ListeningHistory {
  id            Int      @id @default(autoincrement())
  userId        String
  mangaId       Int
  chapterId     Int
  timeListened  Int // Total time in seconds for this session
  startTime     Float // Where playback started (seconds)
  endTime       Float // Where playback ended (seconds)
  playbackSpeed Float    @default(1.0)
  startedAt     DateTime @default(now())
  endedAt       DateTime

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga   Manga   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mangaId])
  @@index([startedAt])
}

model ListeningAnalytics {
  id                  Int      @id @default(autoincrement())
  userId              String
  date                DateTime @db.Date
  minutesListened     Int      @default(0)
  chaptersCompleted   Int      @default(0)
  audiobooksCompleted Int      @default(0)
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  userId     String
  name       String
  key        String    @unique
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

model Webhook {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  userId       String
  url          String
  secret       String
  events       String[] // Array of event types
  enabled      Boolean  @default(true)
  failureCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  webhookId   String
  event       String
  payload     Json
  statusCode  Int?
  success     Boolean  @default(false)
  error       String?
  attemptedAt DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([attemptedAt])
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model jobs {
  id                  BigInt      @default(autoincrement())
  queue_name          String      @default("default")
  job_type            JobType
  priority            JobPriority @default(normal)
  payload             Json        @default("{}")
  result              Json?
  metadata            Json?       @default("{}")
  status              JobStatus   @default(pending)
  progress            Int?        @default(0)
  created_at          DateTime    @default(now()) @db.Timestamptz(6)
  scheduled_for       DateTime    @default(now()) @db.Timestamptz(6)
  started_at          DateTime?   @db.Timestamptz(6)
  completed_at        DateTime?   @db.Timestamptz(6)
  attempt_count       Int         @default(0)
  max_attempts        Int         @default(3)
  retry_delay_seconds Int?        @default(60)
  last_error          Json?
  worker_id           String?
  lease_expires_at    DateTime?   @db.Timestamptz(6)
  hard_timeout_at     DateTime?   @db.Timestamptz(6) // Absolute deadline for job completion
  processing_time_ms  Int?
  wait_time_ms        Int?
  manga_id            Int?
  chapter_id          Int?
  partition_key       String      @default("active")
  manga               Manga?      @relation(fields: [manga_id], references: [id], onDelete: SetNull)
  chapter             Chapter?    @relation(fields: [chapter_id], references: [id], onDelete: SetNull)

  @@id([id, partition_key])
}

model queue_config {
  queue_name                  String    @id
  is_active                   Boolean?  @default(true)
  max_concurrent_jobs         Int?      @default(10)
  default_priority            Int?      @default(50)
  default_max_attempts        Int?      @default(3)
  default_retry_delay_seconds Int?      @default(60)
  rate_limit_per_second       Int?
  metadata                    Json?     @default("{}")
  created_at                  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime? @default(now()) @db.Timestamptz(6)
}

model workers {
  worker_id         String   @id
  hostname          String
  pid               Int
  queue_names       String[] @default(["default"])
  status            String   @default("active")
  started_at        DateTime @default(now()) @db.Timestamptz(6)
  last_heartbeat_at DateTime @default(now()) @db.Timestamptz(6)
  jobs_processed    Int?     @default(0)
  jobs_failed       Int?     @default(0)
  metadata          Json?    @default("{}")

  @@index([last_heartbeat_at], map: "idx_workers_heartbeat")
  @@index([status, queue_names], map: "idx_workers_status")
}

// ============================================================================
// Native Download Models
// ============================================================================

// NativeDownload tracks individual download tasks
// sourceType identifies the download source ('MANGADEX', 'GETCOMICS', etc.)
model NativeDownload {
  id              String               @id @default(cuid())
  sourceId        String? // Optional: legacy field, use sourceType instead
  mangaId         Int
  chapterId       Int? // Internal Chapter.id when one already exists
  sourceChapterId String? // Source-side chapter identifier (e.g. MangaDex UUID, GetComics issue id)
  chapterNumber   Float
  status          NativeDownloadStatus @default(QUEUED)
  progress        Int                  @default(0)
  destinationPath String?
  error           String?
