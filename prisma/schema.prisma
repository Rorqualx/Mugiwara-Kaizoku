  avgResponseTime Float?
  minResponseTime Int?
  maxResponseTime Int?
  p95ResponseTime Int?
  uptimePercent   Float?
  avgSessionCount Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hour])
}

enum FlareSolverrRequestType {
  HEALTH_CHECK
  FETCH_REQUEST
  SESSION_CREATE
  SESSION_DESTROY
  SESSION_LIST
}

// ============================================================================
// ML Annotation System - Training Data for Transformer-CRF
// ============================================================================

model AnnotatedPage {
  id              String               @id @default(cuid())
  url             String               @unique
  mangaTitle      String? // Optional: Associated manga title for reference
  sourceType      AnnotationSourceType // fandom, wikipedia, anilist, comicvine
  htmlSnapshot    String // Stored HTML at annotation time (can be large)
  tokens          Json // Linearized token array [{id, text, tagName, xpath...}]
  labels          Json // BIO label array (same length as tokens)
  selections      Json? // TextSelection[] - source of truth for user annotations
  features        Json? // Pre-extracted features for training
  annotatorId     String? // User who annotated (null for bootstrap)
  annotator       User?                @relation(fields: [annotatorId], references: [id], onDelete: SetNull)
  status          AnnotationStatus     @default(BOOTSTRAP)
  confidence      Float? // Average model confidence if ML-assisted
  entityCounts    Json? // {TITLE: 1, AUTHOR: 2, ...} for quick stats
  urlAnnotations  Json? // [{label: "CHAPTERS_LIST_URL", url: "...", text: "..."}]
  notes           String? // Annotator notes
  version         Int                  @default(0) // Optimistic locking version
  previousVersion Json? // Backup of previous state for rollback
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  reviewedAt      DateTime? // When it was reviewed
  exportedAt      DateTime? // When it was exported for training

  // ═══════════════════════════════════════════════════════════════════════════
  // Agent Review Fields - LLM-based label verification
  // ═══════════════════════════════════════════════════════════════════════════

  agentReviewedAt   DateTime? // When agent reviewed this page
  agentReviewNotes  String?   @db.Text // Agent's summary of findings
  agentCorrections  Json? // { added: [], removed: [], modified: [] }
  agentConfidence   Float? // 0-1 overall agent confidence in corrections
  agentIssuesFound  Json? // { errors: [], warnings: [], suggestions: [] }
  agentModelVersion String? // Track which model version did the review (e.g., "claude-3-5-sonnet")

  // ═══════════════════════════════════════════════════════════════════════════
  // LLM Training Data Fields (Phase 1 Addition)
  // ═══════════════════════════════════════════════════════════════════════════

  // Document-level classification
  documentCategory DocumentCategory? // synopsis, review, reference, etc.
  qualityTier      QualityTier? // high, medium, low, exclude
  useCases         UseCaseLabel[]    @default([]) // instruction_tuning, qa, etc.

  // Segments (derived from tokens, cached for performance)
  segments Json? // { paragraphs[], sections[], markdown, plainText }

  // Image-specific labels (extends existing image tokens)
  imageLabels Json? // ImageLabel[] for image tokens

  // Auto quality scoring (complements IAA)
  autoQualityScore Float? // 0-1 composite score
  qualityFactors   Json? // Breakdown of score factors

  // ═══════════════════════════════════════════════════════════════════════════
  // Provider Discovery URLs (Cross-Reference Fields)
  // ═══════════════════════════════════════════════════════════════════════════

  comicVineId             String? // ComicVine volume/series ID
  fandomDiscoveredUrls    Json? // Discovered Fandom URLs [{url, type, discoveredAt}]
  wikipediaDiscoveredUrls Json? // Discovered Wikipedia URLs [{url, type, discoveredAt}]
  comicVineDiscoveredUrls Json? // Discovered ComicVine URLs [{url, type, discoveredAt}]

  // ═══════════════════════════════════════════════════════════════════════════

  qualityMetrics AnnotationQualityMetric[]

  // List page relationship extraction
  listPageRecord ListPageRecord?

  @@index([sourceType])
  @@index([status])
  @@index([annotatorId])
  @@index([mangaTitle])
  @@index([createdAt])
  @@index([documentCategory])
  @@index([qualityTier])
  @@index([autoQualityScore])
  @@index([agentReviewedAt])
  @@index([agentConfidence])
}

/// Quality metrics for annotation pages
/// Stores IAA (Inter-Annotator Agreement) calculations
model AnnotationQualityMetric {
  id           String        @id @default(cuid())
  pageId       String
  page         AnnotatedPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  alpha        Float // Krippendorff's alpha coefficient
  qualityLevel String // 'excellent' | 'good' | 'fair' | 'poor'
  entityScores Json // Per-entity alpha scores [{entity, alpha, count}]
  annotators   Json // List of annotator IDs compared
  calculatedAt DateTime      @default(now())

  @@index([pageId])
  @@index([calculatedAt])
  @@index([qualityLevel])
}

model AnnotationSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pagesLabeled  Int       @default(0)
  tokensLabeled Int       @default(0)
  timeSpent     Int       @default(0) // Total seconds spent annotating
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  sourceTypes   String[]  @default([]) // Which sources were annotated
  notes         String?

  @@index([userId])
  @@index([startedAt])
}

model TrainingDataExport {
  id           String   @id @default(cuid())
  version      String // Semantic version e.g., "1.0.0"
  pageCount    Int // Number of pages included
  tokenCount   Int // Total tokens
  entityCounts Json // {TITLE: X, AUTHOR: Y, ...}
  splitRatios  Json // {train: 0.8, val: 0.1, test: 0.1}
  filePath     String // Path to exported data file
  fileSize     BigInt // Size in bytes
  format       String   @default("json") // json, conll, etc.
  modelVersion String? // Associated model version if trained
  notes        String?
  createdAt    DateTime @default(now())
  createdById  String?

  // ═══════════════════════════════════════════════════════════════════════════
  // LLM Training Data Export Fields (Phase 1 Addition)
  // ═══════════════════════════════════════════════════════════════════════════

  // Document-level filters used for this export
  categoryFilter DocumentCategory[] @default([])
  qualityFilter  QualityTier[]      @default([])
  useCaseFilter  UseCaseLabel[]     @default([])
  minAutoQuality Float? // Minimum auto quality score filter

  // Export configuration
  exportFormat       ExportFormat? // Typed format (replaces string format long-term)
  includeSegments    Boolean       @default(false)
  includeMarkdown    Boolean       @default(false)
  includeImageLabels Boolean       @default(false)

  // Statistics for LLM training formats
  recordCount     Int? // Number of training records (may differ from pageCount)
  avgQualityScore Float? // Average auto quality score of exported pages

  // ═══════════════════════════════════════════════════════════════════════════

  @@index([version])
  @@index([createdAt])
  @@index([exportFormat])
}

model MLModelVersion {
  id             String      @id @default(cuid())
  version        String      @unique // e.g., "1.0.0"
  modelType      String      @default("transformer-crf") // transformer-crf, layoutlmv3, etc.
  backbone       String      @default("layoutlmv3-base") // Transformer backbone
  trainingDataId String? // Link to TrainingDataExport
  metrics        Json? // {micro_f1: 0.88, per_entity: {...}}
  config         Json? // Training config/hyperparameters
  onnxPath       String? // Path to ONNX model file
  status         ModelStatus @default(TRAINING)
  trainedAt      DateTime?
  deployedAt     DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([version])
  @@index([status])
  @@index([modelType])
}

enum AnnotationSourceType {
  FANDOM
  WIKIPEDIA
  ANILIST
  COMICVINE
}

enum AnnotationStatus {
  BOOTSTRAP // Auto-labeled by existing extractors
  AGENT_REVIEWED // Verified/corrected by LLM agent
  IN_PROGRESS // Currently being annotated
  REVIEWED // Reviewed by human annotator
  GOLD // High-quality, verified annotation
  REJECTED // Rejected/problematic page
}

// ============================================================================
// List Page Relationship Extraction Models
// ============================================================================

/// Master record for list pages containing chapter-volume relationships
/// Used for ML training to extract explicit relationship ground truth
model ListPageRecord {
  id              String        @id @default(cuid())
  annotatedPageId String        @unique
  annotatedPage   AnnotatedPage @relation(fields: [annotatedPageId], references: [id], onDelete: Cascade)

  // Counts for validation
  tableCount   Int @default(0)
  volumeCount  Int @default(0)
  chapterCount Int @default(0)

  // Relationships
  volumeRecords  VolumeListRecord[]
  chapterRecords ChapterListRecord[]

  // Validation status
  validationStatus ListValidationStatus @default(UNVALIDATED)
  validationNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([validationStatus])
}

/// Volume entry from a list page (ground truth for ML)
model VolumeListRecord {
  id         String         @id @default(cuid())
  listPageId String
  listPage   ListPageRecord @relation(fields: [listPageId], references: [id], onDelete: Cascade)

  // Core data
  volumeNumber Int
  volumeTitle  String? @db.VarChar(500)

  // Token positions (for training span mapping)
  numberTokenIndex Int?
  titleTokenStart  Int?
  titleTokenEnd    Int?

  // Extracted metadata
  volumeUrl     String? @db.VarChar(1000)
  coverImageUrl String? @db.VarChar(1000)
  isbn          String? @db.VarChar(20)
  releaseDate   String? @db.VarChar(50)

  // Chapter range
  chapterStart Float?
  chapterEnd   Float?

  // Table position
  tableId  String? @db.VarChar(50)
  tableRow Int?

  // Confidence
  confidence Float @default(1.0)

  // Related chapters
  chapters ChapterListRecord[]

  @@unique([listPageId, volumeNumber])
  @@index([listPageId])
}

/// Chapter entry with explicit volume relationship
model ChapterListRecord {
  id         String         @id @default(cuid())
  listPageId String
  listPage   ListPageRecord @relation(fields: [listPageId], references: [id], onDelete: Cascade)

  // Parent volume (EXPLICIT RELATIONSHIP)
  volumeRecordId String?
  volumeRecord   VolumeListRecord? @relation(fields: [volumeRecordId], references: [id], onDelete: SetNull)
  volumeNumber   Int? // Denormalized for quick access

  // Core data
  chapterNumber Float
  chapterTitle  String? @db.VarChar(500)

  // Token positions
  numberTokenIndex Int?
  titleTokenStart  Int?
  titleTokenEnd    Int?
  urlTokenIndex    Int?

  // Extracted metadata
  chapterUrl  String? @db.VarChar(1000)
  releaseDate String? @db.VarChar(50)

  // Table position
  tableId  String? @db.VarChar(50)
  tableRow Int?

  // Relationship source
  relationSource RelationSource @default(INFERRED)
  confidence     Float          @default(1.0)

  @@unique([listPageId, chapterNumber])
  @@index([listPageId])
  @@index([volumeRecordId])
}

/// Validation status for list page records
enum ListValidationStatus {
  UNVALIDATED
  VALIDATED
  NEEDS_REVIEW
  REJECTED
}

/// Source of chapter-volume relationship determination
enum RelationSource {
  SAME_TABLE_ROW // Chapter and volume in same row
  VOLUME_SECTION // Chapter under volume header
  EXPLICIT_LABEL // "Vol. X" text in chapter row
  SPANNING_ROW // Chapter in colspan row below volume (Wikipedia pattern)
  INFERRED // Derived from context
}

enum ModelStatus {
  TRAINING
  TRAINED
  VALIDATING
  DEPLOYED
  ARCHIVED
  FAILED
}

// ============================================================================
// LLM Training Data Enums (Phase 1 Addition)
// ============================================================================

/// Document-level category classification for LLM training data
enum DocumentCategory {
  SYNOPSIS // Plot summaries
  REVIEW // Reviews and opinions
  ANALYSIS // Deep analysis/essays
  NEWS // News and announcements
  REFERENCE // Wiki/reference content
  DISCUSSION // Community discussions
  METADATA // Pure metadata
  MIXED // Multiple categories
}

/// Quality tier for filtering training data
enum QualityTier {
  HIGH // Well-written, comprehensive
  MEDIUM // Acceptable quality
  LOW // Poor quality, may need filtering
  EXCLUDE // Should not be used for training
}

/// Use case labels for LLM training data routing
enum UseCaseLabel {
  INSTRUCTION_TUNING // Good for instruction following
  SUMMARIZATION // Good for summarization training
  QA // Good for Q&A pairs
