// ============================================================================
// FlareSolverr Configuration
// ============================================================================

model FlareSolverrConfig {
  id                   String   @id @default("default") // Singleton pattern
  enabled              Boolean  @default(true)
  autoStart            Boolean  @default(false) // Auto-start internal instance on app launch
  url                  String   @default("http://localhost:8191/v1")
  timeout              Int      @default(60000) // Request timeout in ms
  sessionTTL           Int      @default(1800000) // Session TTL in ms (30 min)
  disableMedia         Boolean  @default(true) // Block images/CSS/fonts - we only need HTML
  defaultWaitSecs      Int      @default(0) // Post-challenge delay in seconds
  // Metrics configuration
  metricsEnabled       Boolean  @default(true)
  metricsRetentionDays Int      @default(7) // Raw metrics retention
  hourlyRetentionDays  Int      @default(30) // Hourly aggregation retention
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ============================================================================
// FlareSolverr Metrics - Health Monitoring
// ============================================================================

model FlareSolverrMetrics {
