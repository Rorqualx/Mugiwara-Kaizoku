  describe('chapters and pages', () => {
    it('should handle unsupported chapter fetching', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createAniListClient(config);
      
      // Act & Assert
      const chapters = await client.getChapters(TEST_MANGA_ID.toString());
      expect(chapters).toEqual([]);
      
      await expect(client.getChapter('1')).rejects.toThrow('AniList does not provide chapter data');
      await expect(client.getChapterPages('1')).rejects.toThrow('AniList does not provide chapter data');
    });
