  isAdult: false,
  staff: createTestMediaStaff(),
  tags: createTestMediaTags(),
  externalLinks: [
    {
      id: 2711,
      url: 'https://www.viz.com/one-piece',
      site: 'Official Site',
      type: 'INFO'
    }
  ]
});

const createTestSearchResponse = (mediaCount: number = 1): AniListSearchResponse => {
  const media: AniListMedia[] = [];
  for (let i = 0; i < mediaCount; i++) {
    const testMedia = createTestMedia();
    testMedia.id = TEST_MANGA_ID + i;
    testMedia.title.english = `${TEST_MANGA_TITLE} ${i > 0 ? i : ''}`;
    media.push(testMedia);
  }
  
  return {
    Page: {
      media
    }
  };
};

const createTestDetailsResponse = (): AniListDetailsResponse => ({
  Media: createTestMedia()
});

// Helper function to create a fully typed client configuration
const createTestConfig = (overrides: Partial<AniListTestConfig> = {}): AniListConfig => {
  const config: AniListConfig = {
    baseURL: overrides.baseURL || TEST_BASE_URL,
    clientId: overrides.clientId || TEST_CLIENT_ID,
    clientSecret: overrides.clientSecret || TEST_CLIENT_SECRET,
    accessToken: overrides.accessToken || TEST_ACCESS_TOKEN,
    defaultLanguage: overrides.defaultLanguage || 'english'
  };
  
  return config;
};

describe.skip('AniListClient', () => {
  // Reset handlers before each test
  beforeEach(() => {
    server.resetHandlers();
  });
  
  describe('constructor', () => {
    it('should create an instance with default options', () => {
      // Arrange
