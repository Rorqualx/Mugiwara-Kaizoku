      // Assert
      expect(client.isAuthenticated()).toBe(false);
    });
  });
  
  describe('factory function', () => {
    it('should create a client instance', () => {
      // Arrange
      const config = createTestConfig();
      
      // Act
      const client = createAniListClient(config);
      
      // Assert
      expect(client).toBeInstanceOf(AniListClient);
      expect(client.getProviderType()).toBe('anilist');
    });
  });
  
  describe('authentication', () => {
    it('should handle token management', () => {
      // Arrange
      const config = createTestConfig({
        accessToken: undefined
      });
      const client = createAniListClient(config);
      const newToken = 'newAccessToken';
      
      // Act & Assert
      expect(client.isAuthenticated()).toBe(false);
      
      client.setAccessToken(newToken);
      expect(client.isAuthenticated()).toBe(true);
      
      client.clearAccessToken();
      expect(client.isAuthenticated()).toBe(false);
    });
    
    it('should authenticate with authorization code', async () => {
      // Arrange
      const config = createTestConfig({
        accessToken: undefined
      });
      const client = createAniListClient(config);
      const authCode = 'auth_code_123';
      
      // Setup mock response
      server.use(
        rest.post('https://anilist.co/api/v2/oauth/token', (req, res, ctx) => {
          const body = req.body as any;
          
          if (body.grant_type === 'authorization_code' &&
              body.client_id === TEST_CLIENT_ID &&
              body.client_secret === TEST_CLIENT_SECRET &&
              body.code === authCode) {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json({
                access_token: TEST_ACCESS_TOKEN,
                token_type: 'Bearer',
                expires_in: 3600
              })
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json({
              error: 'invalid_request',
              error_description: 'Invalid authorization code'
            })
          );
        })
      );
      
      // Act
      const token = await client.authenticate(authCode);
      
      // Assert
      expect(token).toBe(TEST_ACCESS_TOKEN);
      expect(client.isAuthenticated()).toBe(true);
    });
    
    it('should handle authentication failure', async () => {
      // Arrange
      const config = createTestConfig({
        accessToken: undefined
      });
      const client = createAniListClient(config);
      const badAuthCode = 'bad_auth_code';
      
      // Setup mock response
      server.use(
        rest.post('https://anilist.co/api/v2/oauth/token', (_req, res, ctx) => {
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json({
              error: 'invalid_request',
              error_description: 'Invalid authorization code'
            })
          );
        })
      );
      
      // Act & Assert
      await expect(client.authenticate(badAuthCode)).rejects.toThrow('Authentication failed');
    });
  });
  
  describe('ping and connection', () => {
    it('should handle successful ping', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createAniListClient(config);
      const searchResponse = createTestSearchResponse(1);
      
      // Setup mock response
