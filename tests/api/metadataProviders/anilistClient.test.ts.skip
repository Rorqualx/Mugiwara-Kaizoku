                }
              }
            ])
          );
        })
      );
      
      // Act & Assert
      await expect(client.getManga(nonExistentId)).rejects.toThrow('GraphQL error: Not Found.');
    });
  });
  
  describe('trending and recently updated', () => {
    it('should get trending manga', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createAniListClient(config);
