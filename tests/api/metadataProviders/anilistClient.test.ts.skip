  describe('mapping functions', () => {
    it('should map AniList status to MangaStatus', async () => {
      // Arrange
      const config = createTestConfig();
      const client = new AniListClient(config);
      
      // Create test media with different statuses
      const statusMappings = [
        { anilist: 'FINISHED', expected: MangaStatus.COMPLETED },
        { anilist: 'RELEASING', expected: MangaStatus.ONGOING },
        { anilist: 'NOT_YET_RELEASED', expected: MangaStatus.UNKNOWN },
        { anilist: 'CANCELLED', expected: MangaStatus.CANCELLED },
        { anilist: 'HIATUS', expected: MangaStatus.HIATUS },
        { anilist: 'UNKNOWN', expected: MangaStatus.UNKNOWN }
      ];
      
      // Mock a search response with different statuses
      const mediaArray: AniListMedia[] = statusMappings.map((mapping, index) => {
        const media = createTestMedia();
        media.id = TEST_MANGA_ID + index;
        media.status = mapping.anilist;
        return media;
      });
      
      // Setup mock response
      server.use(
        graphql.query('Page', (_req, res, ctx) => {
          return res(
            ctx.data({
              Page: {
                media: mediaArray
              }
            })
          );
        })
      );
      
      // Act
      const results = await client.search('status test');
      
      // Assert
      results.forEach((manga, index) => {
        expect(manga.status).toBe(statusMappings[index].expected);
      });
    });
    
    it('should map AniList isAdult to ContentRating', async () => {
      // Arrange
      const config = createTestConfig();
      const client = new AniListClient(config);
      
      // Create test media with different adult flags
      const contentRatingMappings = [
        { isAdult: true, expected: ContentRating.EXPLICIT },
        { isAdult: false, expected: ContentRating.SAFE }
      ];
      
      // Mock a search response with different adult flags
      const mediaArray: AniListMedia[] = contentRatingMappings.map((mapping, index) => {
        const media = createTestMedia();
        media.id = TEST_MANGA_ID + index;
        media.isAdult = mapping.isAdult;
        return media;
      });
      
      // Setup mock response
      server.use(
        graphql.query('Page', (_req, res, ctx) => {
          return res(
            ctx.data({
              Page: {
                media: mediaArray
              }
            })
          );
        })
      );
      
      // Act
      const results = await client.search('content rating test');
      
      // Assert
      results.forEach((manga, index) => {
        expect(manga.contentRating).toBe(contentRatingMappings[index].expected);
      });
    });
    
    it('should get preferred title based on language setting', async () => {
      // Arrange
      const configEnglish = createTestConfig({ defaultLanguage: 'english' });
      const configRomaji = createTestConfig({ defaultLanguage: 'romaji' });
      const configNative = createTestConfig({ defaultLanguage: 'native' });
      
      const clientEnglish = createAniListClient(configEnglish);
      const clientRomaji = createAniListClient(configRomaji);
      const clientNative = createAniListClient(configNative);
      
      const media = createTestMedia();
      const mediaWithoutEnglish = { ...media };
      mediaWithoutEnglish.title = { 
        romaji: 'One Piece',
        native: 'ワンピース'
      };
      
      // Setup mock responses
      server.use(
        graphql.query('Media', (_req, res, ctx) => {
          return res(
            ctx.data({
              Media: media
            })
          );
        })
      );
      
      // Act
      const resultEnglish = await clientEnglish.getManga(TEST_MANGA_ID.toString());
      
      // Change mock for next test
      server.resetHandlers();
      server.use(
        graphql.query('Media', (_req, res, ctx) => {
          return res(
            ctx.data({
              Media: mediaWithoutEnglish
            })
          );
        })
      );
      
      const resultRomaji = await clientRomaji.getManga(TEST_MANGA_ID.toString());
      const resultNative = await clientNative.getManga(TEST_MANGA_ID.toString());
      
      // Assert
      expect(resultEnglish.title).toBe('One Piece'); // English title
      expect(resultRomaji.title).toBe('One Piece'); // Romaji title
      expect(resultNative.title).toBe('ワンピース'); // Native title
    });
  });
  
  describe('caching', () => {
    it('should cache search results', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createAniListClient(config);
      const searchQuery = 'cache test';
      const searchResponse = createTestSearchResponse(1);
      
      // Setup mock response with a counter to track calls
      let callCount = 0;
      server.use(
        graphql.query('Page', (_req, res, ctx) => {
          callCount++;
          return res(
            ctx.data({
              Page: searchResponse.Page
            })
          );
        })
      );
      
      // Act - First call should make a request
      const result1 = await client.search(searchQuery);
      
      // Second call with same query should use cache
      const result2 = await client.search(searchQuery);
      
      // Assert
      expect(callCount).toBe(1); // Only one actual API call
      expect(result1).toHaveLength(1);
      expect(result2).toHaveLength(1);
      expect(result1[0].id).toBe(result2[0].id);
    });
  });
  
  describe('resource management', () => {
    it('should dispose resources correctly', () => {
      // Arrange
      const config = createTestConfig();
      const client = createAniListClient(config);
      
      // Act
      client.dispose();
      
      // Assert
      expect(client.isDisposed()).toBe(true);
    });
    
    it('should reject requests after disposal', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createAniListClient(config);
      
      // Act
      client.dispose();
      
      // Assert - The base client should prevent API calls after disposal
      await expect(client.testConnection()).rejects.toThrow();
    });
  });
});