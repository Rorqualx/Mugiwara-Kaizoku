  },
  {
    id: 95,
    name: 'Super Power',
    rank: 92,
    isMediaSpoiler: false,
    isAdult: false
  }
];

const createTestMedia = (): AniListMedia => ({
  id: TEST_MANGA_ID,
  title: createTestMediaTitle(),
  description: 'Gol D. Roger was known as the "Pirate King," the strongest and most infamous being to have sailed the Grand Line...',
  coverImage: createTestMediaCoverImage(),
  bannerImage: 'https://s4.anilist.co/file/anilistcdn/media/manga/banner/30013-aKxVIANHitLw.jpg',
  status: 'RELEASING',
  chapters: 1090,
  volumes: 106,
