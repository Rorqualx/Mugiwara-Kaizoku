// Setup test server
setupApiTestServer();

// Test fixtures with strict typing
const TEST_BASE_URL = 'https://graphql.anilist.co';
const TEST_CLIENT_ID = 'clientId123';
const TEST_CLIENT_SECRET = 'clientSecret456';
const TEST_ACCESS_TOKEN = 'accessToken789';

// Test manga fixtures
const TEST_MANGA_ID = 30013;
const TEST_MANGA_TITLE = 'One Piece';

// AniList API response fixtures with complete type definitions
interface AniListMediaTitle {
  romaji?: string;
  english?: string;
  native?: string;
}

interface AniListMediaCoverImage {
  large?: string;
  medium?: string;
}

interface AniListMediaDate {
  year?: number;
  month?: number;
  day?: number;
}

interface AniListMediaStaffNode {
  id?: number;
  name?: {
    full?: string;
    native?: string;
  };
}

interface AniListMediaStaffEdge {
  role?: string;
  node?: AniListMediaStaffNode;
}

interface AniListMediaStaff {
  edges?: AniListMediaStaffEdge[];
}

interface AniListMediaCharacterNode {
  id?: number;
  name?: {
    full?: string;
    native?: string;
  };
}

interface AniListMediaCharacterEdge {
  role?: string;
  node?: AniListMediaCharacterNode;
}

interface AniListMediaCharacters {
  edges?: AniListMediaCharacterEdge[];
}

interface AniListMediaTag {
  id?: number;
  name?: string;
  rank?: number;
  isMediaSpoiler?: boolean;
  isAdult?: boolean;
}

interface AniListMediaExternalLink {
  id?: number;
  url?: string;
  site?: string;
  type?: string;
}

interface AniListMedia {
  id: number;
  title: AniListMediaTitle;
  description?: string;
  coverImage?: AniListMediaCoverImage;
  bannerImage?: string;
  status?: string;
  chapters?: number;
  volumes?: number;
  format?: string;
  startDate?: AniListMediaDate;
  endDate?: AniListMediaDate;
  genres?: string[];
  synonyms?: string[];
  averageScore?: number;
  popularity?: number;
  countryOfOrigin?: string;
  isAdult?: boolean;
  staff?: AniListMediaStaff;
  characters?: AniListMediaCharacters;
  tags?: AniListMediaTag[];
  externalLinks?: AniListMediaExternalLink[];
}

interface AniListSearchResponse {
  Page: {
    media: AniListMedia[];
  };
}

interface AniListDetailsResponse {
  Media: AniListMedia;
}

interface GraphQLResponse<T> {
  data?: T;
  errors?: Array<{
    message: string;
    locations?: Array<{ line: number; column: number }>;
    path?: string[];
    extensions?: {
      code?: string;
    };
  }>;
}

// Create test data with explicit typing
const createTestMediaTitle = (): AniListMediaTitle => ({
  romaji: 'One Piece',
  english: 'One Piece',
  native: 'ワンピース'
});

const createTestMediaCoverImage = (): AniListMediaCoverImage => ({
  large: 'https://s4.anilist.co/file/anilistcdn/media/manga/cover/large/bx30013-oT7YguhEK1TE.jpg',
  medium: 'https://s4.anilist.co/file/anilistcdn/media/manga/cover/medium/bx30013-oT7YguhEK1TE.jpg'
});

const createTestMediaDate = (): AniListMediaDate => ({
  year: 1997,
  month: 7,
  day: 22
});

const createTestMediaStaff = (): AniListMediaStaff => ({
  edges: [
    {
      role: 'Story & Art',
      node: {
        id: 96892,
        name: {
          full: 'Eiichiro Oda',
          native: '尾田栄一郎'
        }
      }
    }
  ]
});

const createTestMediaTags = (): AniListMediaTag[] => [
  {
    id: 170,
    name: 'Pirates',
    rank: 99,
    isMediaSpoiler: false,
    isAdult: false
  },
  {
