  describe('getManga', () => {
    it('should get manga details by ID', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createAniListClient(config);
      const mangaId = TEST_MANGA_ID.toString();
      const detailsResponse = createTestDetailsResponse();
      
      // Setup mock response
      server.use(
        graphql.query('Media', (req, res, ctx) => {
          const variables = req.variables as Record<string, any>;
          expect(variables.id).toBe(TEST_MANGA_ID);
          
          return res(
            ctx.data({
              Media: detailsResponse.Media
            })
          );
        })
      );
      
      // Act
      const result = await client.getManga(mangaId);
      
      // Assert
      expect(result.id).toBe(mangaId);
      expect(result.title).toBe(TEST_MANGA_TITLE);
      expect(result.description).toBe(detailsResponse.Media.description);
      expect(result.status).toBe(MangaStatus.ONGOING);
      expect(result.contentRating).toBe(ContentRating.SAFE);
      expect(result.coverImage).toBe(detailsResponse.Media.coverImage?.large);
      expect(result.year).toBe(1997);
      expect(result.authors).toHaveLength(1);
      expect(result.authors?.[0].name).toBe('Eiichiro Oda');
      expect(result.sourceUrl).toBe(`https://anilist.co/manga/${mangaId}`);
    });
    
    it('should handle manga not found', async () => {
