  describe('mapStatus', () => {
    it('should map NZBGet status to DownloadStatus', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      
      // Create test groups with different statuses
      const groups = [
        { ...createTestGroup(), Status: 'QUEUED' },
        { ...createTestGroup(), Status: 'PAUSED' },
        { ...createTestGroup(), Status: 'DOWNLOADING' },
        { ...createTestGroup(), Status: 'FETCHING' },
        { ...createTestGroup(), Status: 'EXECUTING_SCRIPT' },
        { ...createTestGroup(), Status: 'SUCCESS' }
      ];
      
      // Create test history items with different statuses
      const historyItems = [
        { ...createCompletedHistoryItem(), Status: 'SUCCESS' },
        { ...createFailedHistoryItem(), Status: 'FAILURE' },
        { ...createFailedHistoryItem(), Status: 'WARNING' },
        { ...createFailedHistoryItem(), Status: 'DELETED' }
      ];
      
      // Setup mock responses
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'listgroups') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, groups))
            );
          }
          
          if (body.method === 'history') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, historyItems))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.getAllItems();
      
      // Assert
      // Group statuses
      expect(result[0].status).toBe(DownloadStatus.QUEUED);
      expect(result[1].status).toBe(DownloadStatus.PAUSED);
      expect(result[2].status).toBe(DownloadStatus.DOWNLOADING);
      expect(result[3].status).toBe(DownloadStatus.DOWNLOADING);
      expect(result[4].status).toBe(DownloadStatus.DOWNLOADING);
      expect(result[5].status).toBe(DownloadStatus.COMPLETED);
      
      // History statuses
      expect(result[6].status).toBe(DownloadStatus.COMPLETED);
      expect(result[7].status).toBe(DownloadStatus.ERROR);
      expect(result[8].status).toBe(DownloadStatus.ERROR);
      expect(result[9].status).toBe(DownloadStatus.ERROR);
    });
  });
  
  describe('proxy mode', () => {
    it('should use proxy endpoint in proxy mode', async () => {
      // Arrange
      const config = createTestConfig({ proxyMode: true });
      const client = createNzbgetClient(config);
      const status = createTestStatus();
      
      // Setup mock response
      server.use(
        rest.post('/api/proxy/nzbget', (req, res, ctx) => {
          const body = req.body as { method: string; params: any[]; username: string; password: string; baseURL: string };
          
          if (body.method === 'status' && body.username === TEST_USERNAME && body.password === TEST_PASSWORD) {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(status)
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json({ error: 'Invalid request' })
          );
        })
      );
      
      // Act
      const result = await client.getServerStatus();
      
      // Assert
      expect(result).toEqual(status);
    });
  });
  
  describe('resource management', () => {
    it('should dispose resources correctly', () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      
      // Act
      client.dispose();
      
      // Assert
      expect(client.isDisposed()).toBe(true);
    });
    
    it('should reject requests after disposal', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      
      // Act
      client.dispose();
      
      // Assert - The base client should prevent API calls after disposal
      await expect(client.testConnection()).rejects.toThrow();
    });
  });
});