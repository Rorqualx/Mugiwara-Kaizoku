import { rest } from 'msw';
import { 
  setupApiTestServer,
  server,
  createRestHandler,
  createErrorHandler,
  createTestData
} from '../setup';
import { 
  NzbgetClient, 
  NzbgetConfig,
  createNzbgetClient
} from '../../../src/api/downloadClients/nzbgetClient';
import { 
  DownloadStatus,
  DownloadItem,
  AddDownloadOptions,
  GetStatusOptions
} from '../../../src/api/base/DownloadClient';
import { 
  NZBGetTestConfig,
  HttpStatus
} from '../fixtures/types';

// Setup test server
setupApiTestServer();

// Test fixtures with strict typing
const TEST_BASE_URL = 'https://nzbget.example.com';
const TEST_USERNAME = 'nzbuser';
const TEST_PASSWORD = 'nzbpass';
const TEST_CATEGORY = 'manga';

// Test NZB fixtures
const TEST_NZB_ID = 123;
const TEST_NZB_NAME = 'Test.NZB.2025.1080p';

// NZBGet API response fixtures with complete type definitions
interface NzbgetRequest {
  jsonrpc: string;
  method: string;
  params: any[];
  id: number;
}

interface NzbgetResponse<T = any> {
  jsonrpc: string;
  result: T;
  error?: {
    code: number;
    message: string;
  };
  id: number;
}

interface NzbgetFile {
  Filename: string;
  FileSizeLo: number;
  RemainingSizeLo?: number;
}

interface NzbgetGroup {
  NZBID: number;
  NZBName: string;
  Status: string;
  Category: string;
  Priority: number;
  FileSizeMB: number;
  RemainingSizeMB: number;
  DownloadedSizeMB: number;
  DownloadRate: number;
  RemainingSizeLo: number;
  DownloadedSizeLo: number;
  MaxPostTime: number;
  AddTime: number;
  DestDir: string;
  FileList?: NzbgetFile[];
  ParStatus: string;
  UnpackStatus: string;
  MessageCount: number;
  HealthOK: boolean;
  HealthTotal: number;
  CriticalHealth: number;
  LogMessages?: string[];
}

interface NzbgetHistoryItem {
  NZBID: number;
  Name: string;
  Status: string;
  Category: string;
  ParStatus: string;
  UnpackStatus: string;
  FileSizeMB: number;
  FileCount: number;
  DownloadedSizeMB: number;
  HistoryTime: number;
  DestDir: string;
  FileList?: NzbgetFile[];
  Log?: string[];
}

interface NzbgetStatus {
  DownloadRate: number;
  DownloadLimit: number;
  UploadRate: number;
  UploadLimit: number;
  RemainingSizeMB: number;
  FreeSpaceMB: number;
  DownloadedSizeMB: number;
  ServerStandBy: boolean;
  ServerPaused: boolean;
  ServerQuota: boolean;
  QuotaReached: boolean;
  ServerTime: number;
  ThreadCount: number;
  DownloadQueueSize: number;
  HistorySize: number;
  Version: string;
}

// Create test data with explicit typing
const createTestGroup = (): NzbgetGroup => ({
  NZBID: TEST_NZB_ID,
  NZBName: TEST_NZB_NAME,
  Status: 'DOWNLOADING',
  Category: TEST_CATEGORY,
  Priority: 0,
  FileSizeMB: 1024, // 1 GB
  RemainingSizeMB: 665, // ~665 MB remaining
  DownloadedSizeMB: 359, // ~359 MB downloaded
  DownloadRate: 1024000, // 1000 KB/s
  RemainingSizeLo: 696254464, // ~665 MB in bytes
  DownloadedSizeLo: 376233984, // ~359 MB in bytes
  MaxPostTime: 0,
  AddTime: Math.floor(Date.now() / 1000) - 3600, // 1 hour ago
  DestDir: '/downloads/incomplete',
  ParStatus: 'NONE',
  UnpackStatus: 'NONE',
  MessageCount: 0,
  HealthOK: true,
  HealthTotal: 100,
  CriticalHealth: 95
});

const createTestGroupWithFiles = (): NzbgetGroup => {
  const group = createTestGroup();
  group.FileList = [
    {
      Filename: 'Test.NZB.2025.1080p.r01',
      FileSizeLo: 536870912, // 512 MB
      RemainingSizeLo: 335544320 // 320 MB remaining
    },
    {
      Filename: 'Test.NZB.2025.1080p.r02',
      FileSizeLo: 536870912, // 512 MB
      RemainingSizeLo: 360710144 // 344 MB remaining
    }
  ];
  return group;
};

const createCompletedHistoryItem = (): NzbgetHistoryItem => ({
  NZBID: TEST_NZB_ID + 1,
  Name: `${TEST_NZB_NAME}.Complete`,
  Status: 'SUCCESS',
  Category: TEST_CATEGORY,
  ParStatus: 'SUCCESS',
  UnpackStatus: 'SUCCESS',
  FileSizeMB: 1024, // 1 GB
  FileCount: 10,
  DownloadedSizeMB: 1024, // Fully downloaded
  HistoryTime: Math.floor(Date.now() / 1000) - 1800, // 30 minutes ago
  DestDir: '/downloads/complete'
});

const createFailedHistoryItem = (): NzbgetHistoryItem => {
  const item = createCompletedHistoryItem();
  item.NZBID = TEST_NZB_ID + 2;
  item.Name = `${TEST_NZB_NAME}.Failed`;
  item.Status = 'FAILURE';
  item.ParStatus = 'FAILURE';
  item.UnpackStatus = 'NONE';
  item.DownloadedSizeMB = 512; // Partially downloaded
  item.Log = ['Failed to download: missing blocks'];
  return item;
};

const createTestStatus = (): NzbgetStatus => ({
  DownloadRate: 1024000, // 1000 KB/s
  DownloadLimit: 0, // No limit
  UploadRate: 0,
  UploadLimit: 0,
  RemainingSizeMB: 665,
  FreeSpaceMB: 102400, // 100 GB
  DownloadedSizeMB: 359,
  ServerStandBy: false,
  ServerPaused: false,
  ServerQuota: false,
  QuotaReached: false,
  ServerTime: Math.floor(Date.now() / 1000),
  ThreadCount: 4,
  DownloadQueueSize: 1,
  HistorySize: 2,
  Version: '21.1'
});

// Helper function to create NZBGet JSON-RPC responses
const createNzbgetResponse = <T>(id: number, result: T, error?: { code: number; message: string }): NzbgetResponse<T> => ({
  jsonrpc: '2.0',
  result,
  error,
  id
});

// Helper function to create a fully typed client configuration
const createTestConfig = (overrides: Partial<NZBGetTestConfig> = {}): NzbgetConfig => {
  const config: NzbgetConfig = {
    baseURL: overrides.baseURL || TEST_BASE_URL,
    username: overrides.username || TEST_USERNAME,
    password: overrides.password || TEST_PASSWORD,
    category: overrides.category || TEST_CATEGORY,
    proxyMode: overrides.proxyMode || false
  };
  
  return config;
};

describe.skip('NzbgetClient', () => {
  // Reset handlers before each test
  beforeEach(() => {
    server.resetHandlers();
  });
  
  describe('constructor', () => {
    it('should create an instance with direct mode', () => {
      // Arrange
      const config = createTestConfig();
      
      // Act
      const client = new NzbgetClient(config);
      
      // Assert
      expect(client).toBeInstanceOf(NzbgetClient);
      expect(client.getClientType()).toBe('nzbget');
    });
    
    it('should create an instance with proxy mode', () => {
      // Arrange
      const config = createTestConfig({ proxyMode: true });
      
      // Act
      const client = new NzbgetClient(config);
      
      // Assert
      expect(client).toBeInstanceOf(NzbgetClient);
      expect(client.getClientType()).toBe('nzbget');
    });
  });
  
  describe('factory function', () => {
    it('should create a client instance', () => {
      // Arrange
      const config = createTestConfig();
      
      // Act
      const client = createNzbgetClient(config);
      
      // Assert
      expect(client).toBeInstanceOf(NzbgetClient);
      expect(client.getClientType()).toBe('nzbget');
    });
  });
  
  describe('ping and connection', () => {
    it('should handle successful ping', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      const status = createTestStatus();
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'status') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, status))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.testConnection();
      
      // Assert
      expect(result).toBe(true);
      expect(client.connectionStatus.connected).toBe(true);
      expect(client.connectionStatus.version).toBe('21.1');
    });
    
    it('should handle failed ping', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (_req, res, ctx) => {
          return res(
            ctx.status(HttpStatus.INTERNAL_SERVER_ERROR),
            ctx.json({ error: 'Server error' })
          );
        })
      );
      
      // Act
      const result = await client.testConnection();
      
      // Assert
      expect(result).toBe(false);
      expect(client.connectionStatus.connected).toBe(false);
      expect(client.connectionStatus.error).toBeDefined();
    });
    
    it('should handle authentication failure', async () => {
      // Arrange
      const config = createTestConfig({ username: 'wronguser', password: 'wrongpass' });
      const client = createNzbgetClient(config);
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          return res(
            ctx.status(HttpStatus.UNAUTHORIZED),
            ctx.json({ error: 'Unauthorized' })
          );
        })
      );
      
      // Act
      const result = await client.testConnection();
      
      // Assert
      expect(result).toBe(false);
      expect(client.connectionStatus.connected).toBe(false);
      expect(client.connectionStatus.error).toBeDefined();
    });
  });
  
  describe('addUrl', () => {
    it('should add an NZB via URL', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      const options: AddDownloadOptions = {
        url: 'https://example.com/test.nzb',
        paused: false,
        category: 'manga'
      };
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'appendurl') {
            const [filename, url, category, priority, paused] = body.params;
            
            expect(url).toBe(options.url);
            expect(category).toBe(options.category);
            expect(paused).toBe(options.paused);
            
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, TEST_NZB_ID))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.addUrl(options);
      
      // Assert
      expect(result).toBe(TEST_NZB_ID.toString());
    });
    
    it('should handle client-specific options', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      const options: AddDownloadOptions = {
        url: 'https://example.com/test.nzb',
        clientSpecific: {
          priority: 100,
          niceName: 'My Test NZB',
          postProcessParams: ['param1=value1', 'param2=value2'],
          dupeKey: 'CUSTOM_KEY'
        }
      };
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'appendurl') {
            const [filename, url, category, priority, paused, niceName, postProcessParams, dupeKey] = body.params;
            
            expect(priority).toBe(options.clientSpecific?.priority);
            expect(niceName).toBe(options.clientSpecific?.niceName);
            expect(postProcessParams).toEqual(options.clientSpecific?.postProcessParams);
            expect(dupeKey).toBe(options.clientSpecific?.dupeKey);
            
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, TEST_NZB_ID))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.addUrl(options);
      
      // Assert
      expect(result).toBe(TEST_NZB_ID.toString());
    });
    
    it('should handle add failure', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      const options: AddDownloadOptions = {
        url: 'https://example.com/invalid.nzb'
      };
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'appendurl') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, 0))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act & Assert
      await expect(client.addUrl(options)).rejects.toThrow('Failed to add NZB');
    });
  });
  
  describe('getStatus', () => {
    it('should get download status from active group', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      const group = createTestGroup();
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'listgroups') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, [group]))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.getStatus(TEST_NZB_ID.toString());
      
      // Assert
      expect(result.id).toBe(TEST_NZB_ID.toString());
      expect(result.name).toBe(TEST_NZB_NAME);
      expect(result.status).toBe(DownloadStatus.DOWNLOADING);
      expect(result.progress).toBe(35); // ~35% downloaded
      expect(result.downloadSpeed).toBe(1024000);
      expect(result.size).toBe(1073741824); // 1 GB
      expect(result.downloaded).toBe(376233984); // ~359 MB
    });
    
    it('should get download status from history', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      const historyItem = createCompletedHistoryItem();
      
      // Setup mock responses
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'listgroups') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, []))
            );
          }
          
          if (body.method === 'history') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, [historyItem]))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.getStatus((TEST_NZB_ID + 1).toString());
      
      // Assert
      expect(result.id).toBe((TEST_NZB_ID + 1).toString());
      expect(result.name).toBe(`${TEST_NZB_NAME}.Complete`);
      expect(result.status).toBe(DownloadStatus.COMPLETED);
      expect(result.progress).toBe(100);
      expect(result.downloadSpeed).toBe(0); // No speed in history
      expect(result.size).toBe(1073741824); // 1 GB
      expect(result.downloaded).toBe(1073741824); // 1 GB
    });
    
    it('should include files when requested', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      const group = createTestGroupWithFiles();
      const options: GetStatusOptions = { includeFiles: true };
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'listgroups') {
            const [includeFiles] = body.params;
            expect(includeFiles).toBe(1);
            
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, [group]))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.getStatus(TEST_NZB_ID.toString(), options);
      
      // Assert
      expect(result.id).toBe(TEST_NZB_ID.toString());
      expect(result.files).toBeDefined();
      expect(result.files?.length).toBe(2);
      expect(result.files?.[0].name).toBe('Test.NZB.2025.1080p.r01');
    });
    
    it('should handle item not found', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      const nonexistentId = '999';
      
      // Setup mock responses
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'listgroups') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, []))
            );
          }
          
          if (body.method === 'history') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, []))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act & Assert
      await expect(client.getStatus(nonexistentId)).rejects.toThrow(`Download with ID ${nonexistentId} not found`);
    });
  });
  
  describe('getAllItems', () => {
    it('should get all downloads from queue and history', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      const group = createTestGroup();
      const completedItem = createCompletedHistoryItem();
      const failedItem = createFailedHistoryItem();
      
      // Setup mock responses
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'listgroups') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, [group]))
            );
          }
          
          if (body.method === 'history') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, [completedItem, failedItem]))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.getAllItems();
      
      // Assert
      expect(result).toHaveLength(3);
      expect(result[0].id).toBe(TEST_NZB_ID.toString());
      expect(result[0].status).toBe(DownloadStatus.DOWNLOADING);
      expect(result[1].id).toBe((TEST_NZB_ID + 1).toString());
      expect(result[1].status).toBe(DownloadStatus.COMPLETED);
      expect(result[2].id).toBe((TEST_NZB_ID + 2).toString());
      expect(result[2].status).toBe(DownloadStatus.ERROR);
    });
    
    it('should include files when requested', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      const group = createTestGroupWithFiles();
      const options: GetStatusOptions = { includeFiles: true };
      
      // Setup mock responses
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'listgroups') {
            const [includeFiles] = body.params;
            expect(includeFiles).toBe(1);
            
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, [group]))
            );
          }
          
          if (body.method === 'history') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, []))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.getAllItems(options);
      
      // Assert
      expect(result).toHaveLength(1);
      expect(result[0].files).toBeDefined();
      expect(result[0].files?.length).toBe(2);
    });
    
    it('should handle empty queue and history', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      
      // Setup mock responses
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'listgroups') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, []))
            );
          }
          
          if (body.method === 'history') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, []))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.getAllItems();
      
      // Assert
      expect(result).toHaveLength(0);
    });
  });
  
  describe('pauseItem', () => {
    it('should pause a download', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'groupPause') {
            const [nzbId] = body.params;
            expect(nzbId).toBe(TEST_NZB_ID);
            
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, true))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.pauseItem(TEST_NZB_ID.toString());
      
      // Assert
      expect(result).toBe(true);
    });
  });
  
  describe('resumeItem', () => {
    it('should resume a download', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'groupResume') {
            const [nzbId] = body.params;
            expect(nzbId).toBe(TEST_NZB_ID);
            
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, true))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.resumeItem(TEST_NZB_ID.toString());
      
      // Assert
      expect(result).toBe(true);
    });
  });
  
  describe('removeItem', () => {
    it('should remove a download without deleting files', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createNzbgetClient(config);
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/jsonrpc`, (req, res, ctx) => {
          const body = req.body as NzbgetRequest;
          
          if (body.method === 'groupFinalDelete') {
            const [nzbId] = body.params;
            expect(nzbId).toBe(TEST_NZB_ID);
            
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createNzbgetResponse(body.id, true))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createNzbgetResponse(body.id, null, { code: 100, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.removeItem(TEST_NZB_ID.toString());
      
      // Assert
      expect(result).toBe(true);
    });
    
