  describe('getStatus', () => {
    it('should get torrent status', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createDelugeClient(config);
      const torrentStatus = createTestTorrentStatus();
      
      // Setup mock responses
      setupAuthenticationMocks();
      
      server.use(
        rest.post(`${TEST_BASE_URL}/json`, (req, res, ctx) => {
          const reqBody = req.body as DelugeRequest;
          
          if (reqBody.method === 'core.get_torrents_status') {
            const [filter] = reqBody.params;
            if (filter.hash === TEST_TORRENT_ID) {
              return res(
                ctx.status(HttpStatus.OK),
                ctx.json(createDelugeResponse(reqBody.id, { [TEST_TORRENT_ID]: torrentStatus }))
              );
            }
          }
          
          // Handle authentication methods with the helper
          return handleAuthMethods(reqBody, res, ctx);
        })
      );
      
      // Act
      const result = await client.getStatus(TEST_TORRENT_ID);
      
      // Assert
      expect(result.id).toBe(TEST_TORRENT_ID);
      expect(result.name).toBe(TEST_TORRENT_NAME);
      expect(result.status).toBe(DownloadStatus.DOWNLOADING);
      expect(result.progress).toBe(35); // 0.35 -> 35%
      expect(result.downloadSpeed).toBe(1024000);
      expect(result.uploadSpeed).toBe(51200);
      expect(result.size).toBe(2147483648);
      expect(result.category).toBe('anime');
    });
    
    it('should include files when requested', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createDelugeClient(config);
      const torrentStatus = createTestTorrentWithFiles();
      const options: GetStatusOptions = { includeFiles: true };
      
      // Setup mock responses
      setupAuthenticationMocks();
      
      server.use(
        rest.post(`${TEST_BASE_URL}/json`, (req, res, ctx) => {
          const reqBody = req.body as DelugeRequest;
          
          if (reqBody.method === 'core.get_torrents_status') {
            const [filter, fields] = reqBody.params;
            if (filter.hash === TEST_TORRENT_ID && fields.includes('files')) {
              return res(
                ctx.status(HttpStatus.OK),
                ctx.json(createDelugeResponse(reqBody.id, { [TEST_TORRENT_ID]: torrentStatus }))
              );
            }
          }
          
          // Handle authentication methods with the helper
          return handleAuthMethods(reqBody, res, ctx);
        })
      );
      
      // Act
      const result = await client.getStatus(TEST_TORRENT_ID, options);
      
      // Assert
      expect(result.id).toBe(TEST_TORRENT_ID);
      expect(result.clientSpecific?.files).toBeDefined();
      expect(result.clientSpecific?.files).toHaveLength(2);
      expect(result.clientSpecific?.files[0].path).toBe('Test.Torrent.2025.1080p.mkv');
    });
    
    it('should handle torrent not found', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createDelugeClient(config);
      const nonExistentId = 'nonexistent';
      
      // Setup mock responses
      setupAuthenticationMocks();
      
      server.use(
        rest.post(`${TEST_BASE_URL}/json`, (req, res, ctx) => {
          const reqBody = req.body as DelugeRequest;
          
          if (reqBody.method === 'core.get_torrents_status') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, {}))
            );
          }
          
          // Handle authentication methods with the helper
          return handleAuthMethods(reqBody, res, ctx);
        })
      );
      
      // Act & Assert
      await expect(client.getStatus(nonExistentId)).rejects.toThrow(`Torrent with ID ${nonExistentId} not found`);
    });
  });
  
  describe('getAllItems', () => {
    it('should get all torrents', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createDelugeClient(config);
      const torrentStatuses = {
        [TEST_TORRENT_ID]: createTestTorrentStatus(),
        [`${TEST_TORRENT_ID}2`]: createCompletedTorrentStatus(),
        [`${TEST_TORRENT_ID}3`]: createPausedTorrentStatus()
      };
      
      // Setup mock responses
      setupAuthenticationMocks();
      
      server.use(
        rest.post(`${TEST_BASE_URL}/json`, (req, res, ctx) => {
          const reqBody = req.body as DelugeRequest;
          
          if (reqBody.method === 'core.get_torrents_status') {
            const [filter] = reqBody.params;
            if (Object.keys(filter).length === 0) {
              return res(
                ctx.status(HttpStatus.OK),
                ctx.json(createDelugeResponse(reqBody.id, torrentStatuses))
              );
            }
          }
          
          // Handle authentication methods with the helper
          return handleAuthMethods(reqBody, res, ctx);
        })
      );
      
      // Act
      const result = await client.getAllItems();
      
      // Assert
      expect(result).toHaveLength(3);
      expect(result[0].status).toBe(DownloadStatus.DOWNLOADING);
      expect(result[1].status).toBe(DownloadStatus.COMPLETED);
      expect(result[2].status).toBe(DownloadStatus.PAUSED);
    });
    
