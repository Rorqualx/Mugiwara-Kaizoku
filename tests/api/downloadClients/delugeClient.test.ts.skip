import { rest } from 'msw';
import { 
  setupApiTestServer,
  server,
  createRestHandler,
  createErrorHandler,
  createTestData
} from '../setup';
import { 
  DelugeClient, 
  DelugeConfig,
  createDelugeClient
} from '../../../src/api/downloadClients/delugeClient';
import { 
  DownloadStatus,
  DownloadItem,
  AddDownloadOptions,
  GetStatusOptions
} from '../../../src/api/base/DownloadClient';
import { 
  DelugeTestConfig,
  HttpStatus
} from '../fixtures/types';

// Setup test server
setupApiTestServer();

// Test fixtures with strict typing
const TEST_BASE_URL = 'https://deluge.example.com';
const TEST_PASSWORD = 'delugepass';
const TEST_HOST_ID = 'local';

// Test torrent fixtures
const TEST_TORRENT_ID = '2d5849g38et3e85a9f0a2e1d8e0a8e1d9f5c0d2b';
const TEST_TORRENT_NAME = 'Test.Torrent.2025.1080p';

// Deluge API response fixtures with complete type definitions
interface DelugeRequest {
  id: number;
  method: string;
  params: any[];
}

interface DelugeResponse<T = any> {
  id: number;
  result: T;
  error?: {
    code: number;
    message: string;
  };
}

interface DelugeTorrentStatus {
  state: string;
  name: string;
  total_size: number;
  progress: number;
  download_payload_rate: number;
  upload_payload_rate: number;
  eta: number;
  ratio: number;
  time_added: number;
  completed_time: number;
  save_path: string;
  total_done: number;
  total_uploaded: number;
  label?: string;
  message?: string;
  files?: DelugeFile[];
}

interface DelugeFile {
  index: number;
  path: string;
  size: number;
  offset: number;
  progress: number;
}

interface DelugeDaemonInfo {
  id: string;
  connected: boolean;
  name: string;
  info: string;
  version: string;
  status: string;
}

enum DelugeErrorCode {
  AUTHENTICATION_FAILED = 1,
  SESSION_INVALID = 2,
  CONNECTION_ERROR = 3,
  METHOD_NOT_FOUND = 4,
  INVALID_PARAMS = 5
}

// Create test data with explicit typing
const createTestTorrentStatus = (): DelugeTorrentStatus => ({
  state: 'Downloading',
  name: TEST_TORRENT_NAME,
  total_size: 2147483648, // 2 GB
  progress: 0.35, // 35%
  download_payload_rate: 1024000, // 1000 KB/s
  upload_payload_rate: 51200, // 50 KB/s
  eta: 1800, // 30 minutes
  ratio: 0.05,
  time_added: Math.floor(Date.now() / 1000) - 3600, // 1 hour ago
  completed_time: 0,
  save_path: '/downloads',
  total_done: 751619276, // ~751 MB
  total_uploaded: 107374182, // ~100 MB
  label: 'anime',
  message: ''
});

const createTestTorrentWithFiles = (): DelugeTorrentStatus => {
  const status = createTestTorrentStatus();
  status.files = [
    {
      index: 0,
      path: 'Test.Torrent.2025.1080p.mkv',
      size: 2147483648, // 2 GB
      offset: 0,
      progress: 0.35 // 35%
    },
    {
      index: 1,
      path: 'Sample/Sample.mkv',
      size: 52428800, // 50 MB
      offset: 2147483648,
      progress: 1.0 // 100%
    }
  ];
  return status;
};

const createCompletedTorrentStatus = (): DelugeTorrentStatus => ({
  state: 'Seeding',
  name: `${TEST_TORRENT_NAME}.Complete`,
  total_size: 1073741824, // 1 GB
  progress: 1.0, // 100%
  download_payload_rate: 0,
  upload_payload_rate: 102400, // 100 KB/s
  eta: 0,
  ratio: 2.5,
  time_added: Math.floor(Date.now() / 1000) - 7200, // 2 hours ago
  completed_time: Math.floor(Date.now() / 1000) - 3600, // 1 hour ago
  save_path: '/downloads',
  total_done: 1073741824, // 1 GB
  total_uploaded: 2684354560, // 2.5 GB
  label: 'completed',
  message: ''
});

const createPausedTorrentStatus = (): DelugeTorrentStatus => {
  const status = createTestTorrentStatus();
  status.state = 'Paused';
  status.download_payload_rate = 0;
  status.upload_payload_rate = 0;
  return status;
};

const createDaemonInfo = (connected: boolean = true): DelugeDaemonInfo => ({
  id: TEST_HOST_ID,
  connected,
  name: 'localhost',
  info: 'Local Deluge instance',
  version: '2.0.5',
  status: connected ? 'Connected' : 'Offline'
});

// Helper function to create Deluge JSON-RPC responses
const createDelugeResponse = <T>(id: number, result: T, error?: { code: number; message: string }): DelugeResponse<T> => ({
  id,
  result,
  error
});

// Helper function to create a fully typed client configuration
const createTestConfig = (overrides: Partial<DelugeTestConfig> = {}): DelugeConfig => {
  const config: DelugeConfig = {
    baseURL: overrides.baseURL || TEST_BASE_URL,
    password: overrides.password || TEST_PASSWORD,
    proxyMode: overrides.proxyMode || false
  };
  
  return config;
};

describe.skip('DelugeClient', () => {
  // Reset handlers before each test
  beforeEach(() => {
    server.resetHandlers();
  });
  
  describe('constructor', () => {
    it('should create an instance with direct mode', () => {
      // Arrange
      const config = createTestConfig();
      
      // Act
      const client = new DelugeClient(config);
      
      // Assert
      expect(client).toBeInstanceOf(DelugeClient);
      expect(client.getClientType()).toBe('deluge');
    });
    
    it('should create an instance with proxy mode', () => {
      // Arrange
      const config = createTestConfig({ proxyMode: true });
      
      // Act
      const client = new DelugeClient(config);
      
      // Assert
      expect(client).toBeInstanceOf(DelugeClient);
      expect(client.getClientType()).toBe('deluge');
    });
  });
  
  describe('factory function', () => {
    it('should create a client instance', () => {
      // Arrange
      const config = createTestConfig();
      
      // Act
      const client = createDelugeClient(config);
      
      // Assert
      expect(client).toBeInstanceOf(DelugeClient);
      expect(client.getClientType()).toBe('deluge');
    });
  });
  
  describe('authentication', () => {
    it('should authenticate and connect to daemon', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createDelugeClient(config);
      
      // Setup mock responses
      let authCalled = false;
      let getHostsCalled = false;
      
      server.use(
        rest.post(`${TEST_BASE_URL}/json`, (req, res, ctx) => {
          const reqBody = req.body as DelugeRequest;
          
          if (reqBody.method === 'auth.login' && !authCalled) {
            authCalled = true;
            return res(
              ctx.status(HttpStatus.OK),
              ctx.set('Set-Cookie', '_session_id=abc123; path=/; HttpOnly'),
              ctx.json(createDelugeResponse(reqBody.id, true))
            );
          }
          
          if (reqBody.method === 'web.get_hosts' && authCalled && !getHostsCalled) {
            getHostsCalled = true;
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, [createDaemonInfo()]))
            );
          }
          
          if (reqBody.method === 'web.connect' && authCalled && getHostsCalled) {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, true))
            );
          }
          
          if (reqBody.method === 'web.get_hosts' && authCalled && getHostsCalled) {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, [createDaemonInfo()]))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createDelugeResponse(reqBody.id, null, { code: 4, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.testConnection();
      
      // Assert
      expect(result).toBe(true);
      expect(client.connectionStatus.connected).toBe(true);
      expect(client.connectionStatus.version).toBe('2.0.5');
    });
    
    it('should handle authentication failure', async () => {
      // Arrange
      const config = createTestConfig({ password: 'wrongpassword' });
      const client = createDelugeClient(config);
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/json`, (req, res, ctx) => {
          const reqBody = req.body as DelugeRequest;
          
          if (reqBody.method === 'auth.login') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, false))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createDelugeResponse(reqBody.id, null, { code: 4, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      await expect(client.testConnection()).rejects.toThrow('Invalid password for Deluge');
    });
    
    it('should handle session invalidation and re-authenticate', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createDelugeClient(config);
      
      // Setup mock responses
      let authAttempts = 0;
      
      server.use(
        rest.post(`${TEST_BASE_URL}/json`, (req, res, ctx) => {
          const reqBody = req.body as DelugeRequest;
          
          if (reqBody.method === 'auth.login') {
            authAttempts++;
            return res(
              ctx.status(HttpStatus.OK),
              ctx.set('Set-Cookie', `_session_id=abc123_${authAttempts}; path=/; HttpOnly`),
              ctx.json(createDelugeResponse(reqBody.id, true))
            );
          }
          
          if (reqBody.method === 'web.get_hosts') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, [createDaemonInfo()]))
            );
          }
          
          if (reqBody.method === 'web.connect') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, true))
            );
          }
          
          if (reqBody.method === 'core.get_torrents_status' && authAttempts === 1) {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, null, { code: 2, message: 'Invalid session' }))
            );
          }
          
          if (reqBody.method === 'core.get_torrents_status' && authAttempts === 2) {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, { [TEST_TORRENT_ID]: createTestTorrentStatus() }))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createDelugeResponse(reqBody.id, null, { code: 4, message: 'Method not found' }))
          );
        })
      );
      
      // Act - First call will authenticate
      await client.testConnection();
      
      // Act - Second call should trigger a session invalidation and re-authentication
      const items = await client.getAllItems();
      
      // Assert
      expect(authAttempts).toBe(2);
      expect(items).toHaveLength(1);
      expect(items[0].id).toBe(TEST_TORRENT_ID);
    });
  });
  
  describe('addUrl', () => {
    it('should add a URL torrent', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createDelugeClient(config);
      const torrentUrl = 'https://example.com/test.torrent';
      const options: AddDownloadOptions = {
        url: torrentUrl,
        destination: '/downloads/anime',
        category: 'anime',
        paused: false
      };
      
      // Setup mock responses for authentication and add torrent
      let authCalled = false;
      let getHostsCalled = false;
      let connectCalled = false;
      
      server.use(
        rest.post(`${TEST_BASE_URL}/json`, (req, res, ctx) => {
          const reqBody = req.body as DelugeRequest;
          
          if (reqBody.method === 'auth.login' && !authCalled) {
            authCalled = true;
            return res(
              ctx.status(HttpStatus.OK),
              ctx.set('Set-Cookie', '_session_id=abc123; path=/; HttpOnly'),
              ctx.json(createDelugeResponse(reqBody.id, true))
            );
          }
          
          if (reqBody.method === 'web.get_hosts' && !getHostsCalled) {
            getHostsCalled = true;
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, [createDaemonInfo()]))
            );
          }
          
          if (reqBody.method === 'web.connect' && !connectCalled) {
            connectCalled = true;
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, true))
            );
          }
          
          if (reqBody.method === 'core.add_torrent_url') {
            const [url, params] = reqBody.params;
            expect(url).toBe(torrentUrl);
            expect(params.download_location).toBe(options.destination);
            expect(params.label).toBe(options.category);
            expect(params.add_paused).toBe(options.paused);
            
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, TEST_TORRENT_ID))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json(createDelugeResponse(reqBody.id, null, { code: 4, message: 'Method not found' }))
          );
        })
      );
      
      // Act
      const result = await client.addUrl(options);
      
      // Assert
      expect(result).toBe(TEST_TORRENT_ID);
    });
    
    it('should add a magnet link', async () => {
