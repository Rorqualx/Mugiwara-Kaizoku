      server.use(
        rest.post(`${TEST_BASE_URL}/json`, (req, res, ctx) => {
          const reqBody = req.body as DelugeRequest;
          
          if (reqBody.method === 'core.remove_torrent') {
            const [torrentId, deleteFiles] = reqBody.params;
            expect(torrentId).toBe(TEST_TORRENT_ID);
            expect(deleteFiles).toBe(false);
            
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, undefined))
            );
          }
          
          // Handle authentication methods with the helper
          return handleAuthMethods(reqBody, res, ctx);
        })
      );
      
      // Act
      const result = await client.removeItem(TEST_TORRENT_ID);
      
      // Assert
      expect(result).toBe(true);
    });
    
    it('should remove a torrent and delete files', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createDelugeClient(config);
      
      // Setup mock responses
      setupAuthenticationMocks();
      
      server.use(
        rest.post(`${TEST_BASE_URL}/json`, (req, res, ctx) => {
          const reqBody = req.body as DelugeRequest;
          
          if (reqBody.method === 'core.remove_torrent') {
            const [torrentId, deleteFiles] = reqBody.params;
            expect(torrentId).toBe(TEST_TORRENT_ID);
            expect(deleteFiles).toBe(true);
            
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, undefined))
            );
          }
          
          // Handle authentication methods with the helper
          return handleAuthMethods(reqBody, res, ctx);
        })
      );
      
      // Act
      const result = await client.removeItem(TEST_TORRENT_ID, true);
      
      // Assert
      expect(result).toBe(true);
    });
  });
  
  describe('mapStatus', () => {
    it('should map Deluge status to DownloadStatus', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createDelugeClient(config);
      
      const torrents = {
        'id1': { ...createTestTorrentStatus(), state: 'Downloading' },
        'id2': { ...createTestTorrentStatus(), state: 'Seeding' },
        'id3': { ...createTestTorrentStatus(), state: 'Paused' },
        'id4': { ...createTestTorrentStatus(), state: 'Queued' },
        'id5': { ...createTestTorrentStatus(), state: 'Checking' },
        'id6': { ...createTestTorrentStatus(), state: 'Allocating' },
        'id7': { ...createTestTorrentStatus(), state: 'Error' },
        'id8': { ...createTestTorrentStatus(), state: 'Unknown' }
      };
      
      // Setup mock responses
      setupAuthenticationMocks();
      
      server.use(
        rest.post(`${TEST_BASE_URL}/json`, (req, res, ctx) => {
          const reqBody = req.body as DelugeRequest;
          
          if (reqBody.method === 'core.get_torrents_status') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, torrents))
            );
          }
          
          // Handle authentication methods with the helper
          return handleAuthMethods(reqBody, res, ctx);
        })
      );
      
      // Act
      const items = await client.getAllItems();
      
      // Assert
      expect(items[0].status).toBe(DownloadStatus.DOWNLOADING);
      expect(items[1].status).toBe(DownloadStatus.COMPLETED);
      expect(items[2].status).toBe(DownloadStatus.PAUSED);
      expect(items[3].status).toBe(DownloadStatus.QUEUED);
      expect(items[4].status).toBe(DownloadStatus.QUEUED);
      expect(items[5].status).toBe(DownloadStatus.DOWNLOADING);
      expect(items[6].status).toBe(DownloadStatus.ERROR);
      expect(items[7].status).toBe(DownloadStatus.UNKNOWN);
    });
  });
  
  describe('proxy mode', () => {
    it('should use proxy endpoint in proxy mode', async () => {
      // Arrange
      const config = createTestConfig({ proxyMode: true });
      const client = createDelugeClient(config);
      
      // Setup mock response
      server.use(
        rest.post('/api/proxy/deluge', (req, res, ctx) => {
          const body = req.body as { method: string; params: any[]; password: string; baseURL: string };
          
          if (body.method === 'auth.login' && body.params[0] === TEST_PASSWORD) {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(1, true))
            );
          }
          
          if (body.method === 'web.get_hosts') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(2, [createDaemonInfo()]))
            );
          }
          
          if (body.method === 'web.connect' && body.params[0] === TEST_HOST_ID) {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(3, true))
            );
          }
          
          return res(
            ctx.status(HttpStatus.BAD_REQUEST),
            ctx.json({ error: 'Invalid request' })
          );
        })
      );
      
      // Act
      const result = await client.testConnection();
      
      // Assert
      expect(result).toBe(true);
    });
  });
  
  describe('resource management', () => {
    it('should dispose resources correctly', () => {
      // Arrange
      const config = createTestConfig();
      const client = createDelugeClient(config);
      
      // Act
      client.dispose();
      
      // Assert
      expect(client.isDisposed()).toBe(true);
    });
    
    it('should reject requests after disposal', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createDelugeClient(config);
      
      // Act
      client.dispose();
      
      // Assert - The base client should prevent API calls after disposal
      await expect(client.testConnection()).rejects.toThrow();
    });
  });
  
  // Helper functions to setup standard authentication mocks
  function setupAuthenticationMocks(): void {
    // Mock variables to track authentication flow
    let authCalled = false;
    let getHostsCalled = false;
    let connectCalled = false;
    
    server.use(
      rest.post(`${TEST_BASE_URL}/json`, (req, res, ctx) => {
        const reqBody = req.body as DelugeRequest;
        
        return handleAuthMethods(reqBody, res, ctx, {
          authCalled,
          getHostsCalled,
          connectCalled,
          setAuthCalled: () => { authCalled = true; },
          setGetHostsCalled: () => { getHostsCalled = true; },
          setConnectCalled: () => { connectCalled = true; }
        });
      })
    );
  }
  
  // Helper function to handle authentication methods
  function handleAuthMethods(
    reqBody: DelugeRequest,
    res: any,
    ctx: any,
    state?: { 
      authCalled: boolean,
      getHostsCalled: boolean,
      connectCalled: boolean,
      setAuthCalled: () => void,
      setGetHostsCalled: () => void,
      setConnectCalled: () => void
    }
  ): any {
    const localState = state || {
      authCalled: false,
      getHostsCalled: false,
      connectCalled: false,
      setAuthCalled: () => {},
      setGetHostsCalled: () => {},
      setConnectCalled: () => {}
    };
    
    if (reqBody.method === 'auth.login' && !localState.authCalled) {
      localState.setAuthCalled();
      return res(
        ctx.status(HttpStatus.OK),
        ctx.set('Set-Cookie', '_session_id=abc123; path=/; HttpOnly'),
        ctx.json(createDelugeResponse(reqBody.id, true))
      );
    }
    
    if (reqBody.method === 'web.get_hosts' && !localState.getHostsCalled) {
      localState.setGetHostsCalled();
      return res(
        ctx.status(HttpStatus.OK),
        ctx.json(createDelugeResponse(reqBody.id, [createDaemonInfo()]))
      );
    }
    
    if (reqBody.method === 'web.connect' && !localState.connectCalled) {
      localState.setConnectCalled();
      return res(
        ctx.status(HttpStatus.OK),
        ctx.json(createDelugeResponse(reqBody.id, true))
      );
    }
    
    return res(
      ctx.status(HttpStatus.BAD_REQUEST),
      ctx.json(createDelugeResponse(reqBody.id, null, { code: 4, message: 'Method not found' }))
    );
  }
});