            );
          }
          
          if (reqBody.method === 'web.get_hosts' && !getHostsCalled) {
            getHostsCalled = true;
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createDelugeResponse(reqBody.id, [createDaemonInfo()]))
            );
          }
          
          if (reqBody.method === 'web.connect' && !connectCalled) {
