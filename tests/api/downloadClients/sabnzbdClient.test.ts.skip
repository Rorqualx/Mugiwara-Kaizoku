  }
});

const createTestHistoryResponse = (items: SabnzbdHistoryItem[] = []): SabnzbdHistoryResponse => ({
  history: {
    total_size: '5368709120',
    month_size: '3221225472',
    week_size: '2147483648',
    day_size: '1073741824',
    slots: items.length > 0 ? items : [createTestHistoryItem()],
    noofslots: items.length > 0 ? items.length : 1
  }
});

const createTestVersionResponse = (): SabnzbdVersionResponse => ({
  version: '3.5.0',
  status: true
});

const createTestStatusResponse = (success: boolean = true, nzoIds: string[] = [TEST_NZB_ID]): SabnzbdStatusResponse => ({
  status: success,
  nzo_ids: success ? nzoIds : undefined,
  error: success ? undefined : 'Failed to perform operation'
});

const createTestQueueStatsResponse = (): SabnzbdQueueStatsResponse => ({
  speed: '1000000', // 1 MB/s in B/s
  size: '1073741824', // 1 GB in bytes
  limit: '10485760', // 10 MB/s
  limit_int: '10485760',
  speedlimit: '10485760',
  speedlimit_int: '10485760',
  status: true
});

// Helper function to create a fully typed client configuration
const createTestConfig = (overrides: Partial<SABnzbdTestConfig> = {}): SabnzbdConfig => {
  const config: SabnzbdConfig = {
    baseURL: overrides.baseURL || TEST_BASE_URL,
    apiKey: overrides.apiKey || TEST_API_KEY,
    category: overrides.category || TEST_CATEGORY,
    proxyMode: overrides.proxyMode || false
  };
  
  return config;
};

