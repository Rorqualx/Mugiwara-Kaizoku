const createTestFailedHistoryItem = (): SabnzbdHistoryItem => {
  const item = createTestHistoryItem();
  item.nzo_id = `${TEST_NZB_ID}_failed`;
  item.name = `${TEST_NZB_NAME}.Failed`;
  item.status = 'Failed';
  item.fail_message = 'Not enough par2 blocks';
  item.completeness = 95;
  return item;
};

const createTestQueueResponse = (items: SabnzbdQueueItem[] = []): SabnzbdQueueResponse => ({
  queue: {
    status: 'Downloading',
    paused: false,
    speed: '1000.0 KB/s',
    kbpersec: '1000.0',
    mbleft: '660.48',
    mb: '1024.0',
