      // Assert
      expect(client).toBeInstanceOf(SabnzbdClient);
      expect(client.getClientType()).toBe('sabnzbd');
    });
  });
  
  describe('ping and connection', () => {
    it('should handle successful ping', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createSabnzbdClient(config);
      
      // Setup mock response
      server.use(
        rest.get(`${TEST_BASE_URL}/api`, (req, res, ctx) => {
          const mode = req.url.searchParams.get('mode');
          const apikey = req.url.searchParams.get('apikey');
          
          if (mode === 'version' && apikey === TEST_API_KEY) {
            return res(
              ctx.status(200),
              ctx.json(createTestVersionResponse())
            );
          }
          
          return res(ctx.status(400));
        })
      );
      
      // Act
      const result = await client.testConnection();
      
      // Assert
      expect(result).toBe(true);
      expect(client.connectionStatus.connected).toBe(true);
      expect(client.connectionStatus.version).toBe('3.5.0');
    });
    
    it('should handle failed ping', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createSabnzbdClient(config);
      
      // Setup mock response
      server.use(
        rest.get(`${TEST_BASE_URL}/api`, (_req, res, ctx) => {
          return res(
            ctx.status(HttpStatus.INTERNAL_SERVER_ERROR),
            ctx.json({ error: 'Server error' })
          );
        })
      );
      
      // Act
      const result = await client.testConnection();
      
      // Assert
      expect(result).toBe(false);
      expect(client.connectionStatus.connected).toBe(false);
      expect(client.connectionStatus.error).toBeDefined();
    });
  });
  
  describe('addUrl', () => {
