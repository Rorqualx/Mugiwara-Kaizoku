          const mode = req.url.searchParams.get('mode');
          const nzoIds = req.url.searchParams.get('nzo_ids');
          const name = req.url.searchParams.get('name');
          const value = req.url.searchParams.get('value');
          
          if (mode === 'queue' && nzoIds === historyId) {
            queueCheckCalled = true;
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestQueueResponse([]))
            );
          }
          
          if (mode === 'history' && name === 'delete' && value === historyId) {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestStatusResponse(true))
            );
          }
          
          return res(ctx.status(400));
        })
      );
      
      // Act
      const result = await client.removeItem(historyId);
      
      // Assert
      expect(result).toBe(true);
    });
    
    it('should handle error when removing item', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createSabnzbdClient(config);
      
      // Setup mock responses
      let queueCheckCalled = false;
      server.use(
        rest.get(`${TEST_BASE_URL}/api`, (req, res, ctx) => {
          const mode = req.url.searchParams.get('mode');
          const nzoIds = req.url.searchParams.get('nzo_ids');
          const name = req.url.searchParams.get('name');
          
          if (mode === 'queue' && nzoIds === TEST_NZB_ID && !queueCheckCalled) {
            queueCheckCalled = true;
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestQueueResponse())
            );
          }
          
          if (mode === 'queue' && name === 'delete') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestStatusResponse(false))
            );
          }
          
          return res(ctx.status(400));
        })
      );
      
      // Act
      const result = await client.removeItem(TEST_NZB_ID);
      
      // Assert
      expect(result).toBe(false);
    });
  });
  
