          if (mode === 'version' && apikey === TEST_API_KEY) {
            return res(
              ctx.status(200),
              ctx.json(createTestVersionResponse())
            );
          }
          
          return res(ctx.status(400));
        })
      );
      
      return expect(client.testConnection()).resolves.toBe(true);
    });
  });
  
  describe('factory function', () => {
    it('should create a client instance', () => {
      // Arrange
