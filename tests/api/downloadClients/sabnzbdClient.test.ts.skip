// Setup test server
setupApiTestServer();

// Test fixtures with strict typing
const TEST_BASE_URL = 'https://sabnzbd.example.com';
const TEST_API_KEY = 'apikey1234567890';
const TEST_CATEGORY = 'manga';

// Test NZB fixtures
const TEST_NZB_ID = 'SABnzbd_nzo_123456789';
const TEST_NZB_NAME = 'Test.NZB.2025.1080p';

// SABnzbd API response fixtures with complete type definitions
interface SabnzbdQueueItem {
  nzo_id: string;
  filename: string;
  status: string;
  cat: string;
  priority: string;
  percentage: string;
  percentcomplete: string;
  mb: string;
  mbmissing: string;
  kbpersec: string;
  mbleft: string;
  timeleft: string;
  eta: string;
  avg_age: string;
  script: string;
  client_agent: string;
  has_rating: boolean;
  rating_avg: string;
  storage: string;
  active_files: string[];
}

interface SabnzbdHistoryItem {
  nzo_id: string;
  name: string;
  category: string;
  status: string;
  size: string;
  bytes: number;
  completed: number;
  download_time: number;
  storage: string;
  path: string;
  script: string;
  stage_log: {
    name: string;
    actions: string[];
  }[];
  downloaded: number;
  completeness: number;
  fail_message: string;
  url: string;
  url_info: string;
}

interface SabnzbdQueueResponse {
  queue: {
    status: string;
    paused: boolean;
    speed: string;
    kbpersec: string;
    mbleft: string;
    mb: string;
    diskspace1: string;
    diskspace2: string;
    timeleft: string;
    slots: SabnzbdQueueItem[];
    noofslots: number;
    finish: number;
    have_warnings: number;
    pause_int: string;
    categories: string[];
    scripts: string[];
    start: number;
  };
}

interface SabnzbdHistoryResponse {
  history: {
    total_size: string;
    month_size: string;
    week_size: string;
    day_size: string;
    slots: SabnzbdHistoryItem[];
    noofslots: number;
  };
}

interface SabnzbdStatusResponse {
  status: boolean;
  nzo_ids?: string[];
  error?: string;
}

interface SabnzbdVersionResponse {
  version: string;
  status: boolean;
}

interface SabnzbdQueueStatsResponse {
  speed: string;
  size: string;
  limit: string;
  limit_int: string;
  speedlimit: string;
  speedlimit_int: string;
  status: boolean;
}

// Create test data with explicit typing
const createTestQueueItem = (): SabnzbdQueueItem => ({
