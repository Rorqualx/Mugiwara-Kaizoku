  describe('mapStatus', () => {
    it('should map SABnzbd status to DownloadStatus', () => {
      // Arrange
      const config = createTestConfig();
      const client = new SabnzbdClient(config);
      
      // Create test queue items with different statuses
      const downloadingItem = createTestQueueItem();
      downloadingItem.status = 'Downloading';
      
      const pausedItem = createTestQueueItem();
      pausedItem.status = 'Paused';
      
      const extractingItem = createTestQueueItem();
      extractingItem.status = 'Extracting';
      
      const repairingItem = createTestQueueItem();
      repairingItem.status = 'Repairing';
      
      const queuedItem = createTestQueueItem();
      queuedItem.status = 'Queued';
      
      const failedItem = createTestQueueItem();
      failedItem.status = 'Failed';
      
      const unknownItem = createTestQueueItem();
      unknownItem.status = 'Unknown';
      
      // Setup mock response
      server.use(
        rest.get(`${TEST_BASE_URL}/api`, (req, res, ctx) => {
          const mode = req.url.searchParams.get('mode');
          
          if (mode === 'queue') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestQueueResponse([
                downloadingItem,
                pausedItem,
                extractingItem,
                repairingItem,
                queuedItem,
                failedItem,
                unknownItem
              ]))
            );
          }
          
          if (mode === 'history') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestHistoryResponse([]))
            );
          }
          
          return res(ctx.status(400));
        })
      );
      
      // Act & Assert
      return client.getAllItems().then(items => {
        expect(items[0].status).toBe(DownloadStatus.DOWNLOADING);
        expect(items[1].status).toBe(DownloadStatus.PAUSED);
        expect(items[2].status).toBe(DownloadStatus.DOWNLOADING);
        expect(items[3].status).toBe(DownloadStatus.DOWNLOADING);
        expect(items[4].status).toBe(DownloadStatus.QUEUED);
        expect(items[5].status).toBe(DownloadStatus.ERROR);
        expect(items[6].status).toBe(DownloadStatus.UNKNOWN);
      });
    });
    
    it('should map history status to DownloadStatus', () => {
      // Arrange
      const config = createTestConfig();
      const client = new SabnzbdClient(config);
      
      // Create test history items with different statuses
      const completedItem = createTestHistoryItem();
      completedItem.status = 'Completed';
      
      const failedItem = createTestFailedHistoryItem();
      failedItem.status = 'Failed';
      
      const unknownItem = createTestHistoryItem();
      unknownItem.status = 'Unknown';
      
      // Setup mock response
      server.use(
        rest.get(`${TEST_BASE_URL}/api`, (req, res, ctx) => {
          const mode = req.url.searchParams.get('mode');
          
          if (mode === 'queue') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestQueueResponse([]))
            );
          }
          
          if (mode === 'history') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestHistoryResponse([
                completedItem,
                failedItem,
                unknownItem
              ]))
            );
          }
          
          return res(ctx.status(400));
        })
      );
      
      // Act & Assert
      return client.getAllItems().then(items => {
        expect(items[0].status).toBe(DownloadStatus.COMPLETED);
        expect(items[1].status).toBe(DownloadStatus.ERROR);
        expect(items[2].status).toBe(DownloadStatus.UNKNOWN);
      });
    });
  });
  
  describe('parseTimeLeft', () => {
    it('should parse time left strings correctly', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createSabnzbdClient(config);
      
      // Create test queue items with different time left values
      const hourItem = createTestQueueItem();
      hourItem.timeleft = '1:23:45';
      
      const minuteItem = createTestQueueItem();
      minuteItem.timeleft = '23:45';
      
      const zeroItem = createTestQueueItem();
      zeroItem.timeleft = '0:00:00';
      
      // Setup mock response
      server.use(
        rest.get(`${TEST_BASE_URL}/api`, (req, res, ctx) => {
          const mode = req.url.searchParams.get('mode');
          
          if (mode === 'queue') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestQueueResponse([hourItem, minuteItem, zeroItem]))
            );
          }
          
          if (mode === 'history') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestHistoryResponse([]))
            );
          }
          
          return res(ctx.status(400));
        })
      );
      
      // Act
      const items = await client.getAllItems();
      
      // Assert
      expect(items[0].eta).toBe(5025); // 1 hour, 23 minutes, 45 seconds
      expect(items[1].eta).toBe(1425); // 23 minutes, 45 seconds
      expect(items[2].eta).toBeUndefined(); // 0 time left
    });
  });
  
