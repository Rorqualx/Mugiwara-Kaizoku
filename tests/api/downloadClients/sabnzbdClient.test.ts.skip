  describe('getStatus', () => {
    it('should get item status from queue', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createSabnzbdClient(config);
      const testQueueItem = createTestQueueItem();
      
      // Setup mock response
      server.use(
        rest.get(`${TEST_BASE_URL}/api`, (req, res, ctx) => {
          const mode = req.url.searchParams.get('mode');
          const nzoIds = req.url.searchParams.get('nzo_ids');
          
          if (mode === 'queue' && nzoIds === TEST_NZB_ID) {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestQueueResponse([testQueueItem]))
            );
          }
          
          return res(ctx.status(400));
        })
      );
      
      // Act
      const result = await client.getStatus(TEST_NZB_ID);
      
      // Assert
      expect(result.id).toBe(TEST_NZB_ID);
      expect(result.name).toBe(TEST_NZB_NAME);
      expect(result.status).toBe(DownloadStatus.DOWNLOADING);
      expect(result.progress).toBe(35.5);
      expect(result.downloadSpeed).toBe(1024000); // 1000 KB/s -> 1024000 B/s
      expect(result.size).toBe(1073741824); // 1024 MB -> 1073741824 bytes
    });
    
    it('should get item status from history if not in queue', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createSabnzbdClient(config);
      const completedId = `${TEST_NZB_ID}_completed`;
      const testHistoryItem = createTestHistoryItem();
      
      // Setup mock responses
      server.use(
        rest.get(`${TEST_BASE_URL}/api`, (req, res, ctx) => {
          const mode = req.url.searchParams.get('mode');
          const nzoIds = req.url.searchParams.get('nzo_ids');
          
          if (mode === 'queue' && nzoIds === completedId) {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestQueueResponse([]))
            );
          }
          
          if (mode === 'history' && nzoIds === completedId) {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestHistoryResponse([testHistoryItem]))
            );
          }
          
          return res(ctx.status(400));
        })
      );
      
      // Act
      const result = await client.getStatus(completedId);
      
      // Assert
      expect(result.id).toBe(completedId);
      expect(result.name).toBe(`${TEST_NZB_NAME}.Complete`);
      expect(result.status).toBe(DownloadStatus.COMPLETED);
      expect(result.progress).toBe(100);
      expect(result.downloadSpeed).toBe(0); // History items don't have speed
      expect(result.size).toBe(1073741824);
    });
    
    it('should handle item not found', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createSabnzbdClient(config);
      const notFoundId = 'nonexistent_id';
      
      // Setup mock responses
      server.use(
        rest.get(`${TEST_BASE_URL}/api`, (req, res, ctx) => {
          const mode = req.url.searchParams.get('mode');
          
          if (mode === 'queue') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestQueueResponse([]))
            );
          }
          
          if (mode === 'history') {
            return res(
              ctx.status(HttpStatus.OK),
              ctx.json(createTestHistoryResponse([]))
            );
          }
          
          return res(ctx.status(400));
        })
      );
      
      // Act & Assert
      await expect(client.getStatus(notFoundId)).rejects.toThrow(`Download with ID ${notFoundId} not found`);
    });
  });
  
  describe('getAllItems', () => {
    it('should get all items from queue and history', async () => {
      // Arrange
      const config = createTestConfig();
