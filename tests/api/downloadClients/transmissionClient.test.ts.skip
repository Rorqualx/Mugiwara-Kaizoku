      // Assert
      expect(result).toHaveLength(2);
      expect(result[0].id).toBe(TEST_TORRENT_ID.toString());
      expect(result[0].status).toBe(DownloadStatus.DOWNLOADING);
      expect(result[1].id).toBe((TEST_TORRENT_ID + 1).toString());
      expect(result[1].status).toBe(DownloadStatus.COMPLETED);
    });
    
    it('should include additional fields when requested', async () => {
