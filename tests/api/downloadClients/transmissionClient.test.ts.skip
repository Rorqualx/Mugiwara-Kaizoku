            ctx.status(HttpStatus.OK),
            ctx.json({
              result: 'success',
              arguments: {}
            })
          );
        })
      );
      
      // Act & Assert
      await expect(client.addUrl(options)).rejects.toThrow('Failed to add torrent');
    });
    
    it('should handle API errors', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createTransmissionClient(config);
      const options: AddDownloadOptions = {
        url: 'https://example.com/test.torrent'
      };
      
      // Setup mock response
