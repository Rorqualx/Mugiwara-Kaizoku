import { rest } from 'msw';
import { 
  setupApiTestServer,
  server,
  createRestHandler,
  createErrorHandler,
  createTestData
} from '../setup';
import { 
  TransmissionClient, 
  TransmissionConfig,
  createTransmissionClient
} from '../../../src/api/downloadClients/transmissionClient';
import { 
  DownloadStatus,
  DownloadItem,
  AddDownloadOptions,
  GetStatusOptions
} from '../../../src/api/base/DownloadClient';
import { 
  TransmissionTestConfig,
  HttpStatus
} from '../fixtures/types';

// Setup test server
setupApiTestServer();

// Test fixtures with strict typing
const TEST_BASE_URL = 'https://transmission.example.com';
const TEST_SESSION_ID = 'test-session-id';
const TEST_USERNAME = 'testuser';
const TEST_PASSWORD = 'testpass';

// Test torrent fixtures
const TEST_TORRENT_ID = 1;
const TEST_TORRENT_HASH = 'abcdef1234567890abcdef1234567890abcdef12';
const TEST_TORRENT_NAME = 'Test.Torrent.2025.1080p';

// Transmission API response fixtures with complete type definitions
interface TransmissionTorrent {
  id: number;
  hashString: string;
  name: string;
  status: number;
  percentDone: number;
  rateDownload: number;
  rateUpload: number;
  eta: number;
  sizeWhenDone: number;
  totalSize: number;
  downloadedEver: number;
  uploadedEver: number;
  uploadRatio: number;
  errorString?: string;
  error?: number;
  addedDate: number;
  doneDate?: number;
  downloadDir: string;
  isFinished?: boolean;
  isStalled?: boolean;
  labels?: string[];
  activityDate?: number;
}

interface TransmissionResponse<T> {
  result: string;
  arguments: T;
  tag?: number;
}

interface TransmissionTorrentAddResponse {
  torrentAdded?: {
    id: number;
    hashString: string;
    name: string;
  };
  torrentDuplicate?: {
    id: number;
    hashString: string;
    name: string;
  };
}

interface TransmissionTorrentsResponse {
  torrents: TransmissionTorrent[];
}

interface TransmissionSessionResponse {
  version: string;
  rpcVersion: number;
  rpcVersionMinimum: number;
  downloadDir: string;
}

// Create test data with explicit typing
const createTestTorrent = (): TransmissionTorrent => ({
  id: TEST_TORRENT_ID,
  hashString: TEST_TORRENT_HASH,
  name: TEST_TORRENT_NAME,
  status: 4, // Downloading
  percentDone: 0.35,
  rateDownload: 1024000,
  rateUpload: 51200,
  eta: 1800,
  sizeWhenDone: 2147483648,
  totalSize: 2147483648,
  downloadedEver: 751619276,
  uploadedEver: 25165824,
  uploadRatio: 0.033,
  addedDate: Math.floor(Date.now() / 1000) - 3600,
  downloadDir: '/downloads',
  labels: ['anime'],
  activityDate: Math.floor(Date.now() / 1000) - 60
});

const createCompletedTorrent = (): TransmissionTorrent => ({
  id: TEST_TORRENT_ID + 1,
  hashString: `${TEST_TORRENT_HASH}2`,
  name: `${TEST_TORRENT_NAME}.Complete`,
  status: 6, // Seeding
  percentDone: 1.0,
  rateDownload: 0,
  rateUpload: 102400,
  eta: -1,
  sizeWhenDone: 1073741824,
  totalSize: 1073741824,
  downloadedEver: 1073741824,
  uploadedEver: 2147483648,
  uploadRatio: 2.0,
  addedDate: Math.floor(Date.now() / 1000) - 7200,
  doneDate: Math.floor(Date.now() / 1000) - 3600,
  downloadDir: '/downloads',
  isFinished: true,
  isStalled: false,
  labels: ['completed', 'anime'],
  activityDate: Math.floor(Date.now() / 1000) - 120
});

const createSessionResponse = (): TransmissionSessionResponse => ({
  version: '3.00 (abcdef123)',
  rpcVersion: 16,
  rpcVersionMinimum: 14,
  downloadDir: '/downloads'
});

const createTorrentAddResponse = (): TransmissionTorrentAddResponse => ({
  torrentAdded: {
    id: TEST_TORRENT_ID,
    hashString: TEST_TORRENT_HASH,
    name: TEST_TORRENT_NAME
  }
});

const createTransmissionResponse = <T>(data: T): TransmissionResponse<T> => ({
  result: 'success',
  arguments: data
});

// Helper function to create a fully typed client configuration
const createTestConfig = (overrides: Partial<TransmissionTestConfig> = {}): TransmissionConfig => {
  const config: TransmissionConfig = {
    baseURL: overrides.baseURL || TEST_BASE_URL,
    username: overrides.username || TEST_USERNAME,
    password: overrides.password || TEST_PASSWORD,
    proxyMode: overrides.proxyMode || false
  };
  
  return config;
};

describe.skip('TransmissionClient', () => {
  // Reset handlers before each test
  beforeEach(() => {
    server.resetHandlers();
  });
  
  describe('constructor', () => {
    it('should create an instance with direct mode', () => {
      // Arrange
      const config = createTestConfig();
      
      // Act
      const client = new TransmissionClient(config);
      
      // Assert
      expect(client).toBeInstanceOf(TransmissionClient);
      expect(client.getClientType()).toBe('transmission');
    });
    
    it('should create an instance with proxy mode', () => {
      // Arrange
      const config = createTestConfig({ proxyMode: true });
      
      // Act
      const client = new TransmissionClient(config);
      
      // Assert
      expect(client).toBeInstanceOf(TransmissionClient);
      expect(client.getClientType()).toBe('transmission');
    });
    
    it('should add /transmission/rpc to baseURL if not present in direct mode', () => {
      // Arrange
      const config = createTestConfig({
        baseURL: 'https://transmission.example.com'
      });
      
      // Act
      const client = new TransmissionClient(config);
      
      // Assert
      expect(client).toBeInstanceOf(TransmissionClient);
      
      // Test ping to verify URL format
      server.use(
        rest.post('https://transmission.example.com/transmission/rpc', (_req, res, ctx) => {
          return res(
            ctx.status(200),
            ctx.json(createTransmissionResponse(createSessionResponse()))
          );
        })
      );
      
      return expect(client.testConnection()).resolves.toBe(true);
    });
  });
  
  describe('factory function', () => {
    it('should create a client instance', () => {
      // Arrange
      const config = createTestConfig();
      
      // Act
      const client = createTransmissionClient(config);
      
      // Assert
      expect(client).toBeInstanceOf(TransmissionClient);
      expect(client.getClientType()).toBe('transmission');
    });
  });
  
  describe('ping and connection', () => {
    it('should handle successful ping', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createTransmissionClient(config);
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/transmission/rpc`, (_req, res, ctx) => {
          return res(
            ctx.status(200),
            ctx.json(createTransmissionResponse(createSessionResponse()))
          );
        })
      );
      
      // Act
      const result = await client.testConnection();
      
      // Assert
      expect(result).toBe(true);
      expect(client.connectionStatus.connected).toBe(true);
      expect(client.connectionStatus.version).toBe('3.00 (abcdef123)');
    });
    
    it('should handle failed ping', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createTransmissionClient(config);
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/transmission/rpc`, (_req, res, ctx) => {
          return res(
            ctx.status(HttpStatus.INTERNAL_SERVER_ERROR),
            ctx.json({ error: 'Server error' })
          );
        })
      );
      
      // Act
      const result = await client.testConnection();
      
      // Assert
      expect(result).toBe(false);
      expect(client.connectionStatus.connected).toBe(false);
      expect(client.connectionStatus.error).toBeDefined();
    });
    
    it('should handle session ID refresh', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createTransmissionClient(config);
      
      // Setup mock responses with session ID flow
      let sessionIdRequested = false;
      server.use(
        rest.post(`${TEST_BASE_URL}/transmission/rpc`, (_req, res, ctx) => {
          if (!sessionIdRequested) {
            sessionIdRequested = true;
            return res(
              ctx.status(HttpStatus.CONFLICT),
              ctx.set('X-Transmission-Session-Id', TEST_SESSION_ID),
              ctx.text('Session ID required')
            );
          }
          
          return res(
            ctx.status(HttpStatus.OK),
            ctx.json(createTransmissionResponse(createSessionResponse()))
          );
        })
      );
      
      // Act
      const result = await client.testConnection();
      
      // Assert
      expect(result).toBe(true);
      expect(client.connectionStatus.connected).toBe(true);
    });
  });
  
  describe('addUrl', () => {
    it('should add a torrent via URL', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createTransmissionClient(config);
      const options: AddDownloadOptions = {
        url: 'https://example.com/test.torrent',
        paused: false,
        destination: '/downloads/anime',
        category: 'anime',
        priority: 1
      };
      
