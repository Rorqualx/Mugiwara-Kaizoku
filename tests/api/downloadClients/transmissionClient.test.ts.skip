      // Assert
      expect(result).toBe(TEST_TORRENT_ID.toString());
    });
    
    it('should handle torrent-add error', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createTransmissionClient(config);
      const options: AddDownloadOptions = {
        url: 'https://example.com/invalid.torrent'
      };
      
      // Setup mock response
