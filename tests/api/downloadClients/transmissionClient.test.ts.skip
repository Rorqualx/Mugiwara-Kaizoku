            ctx.json({ error: 'Internal server error' })
          );
        })
      );
      
      // Act & Assert
      await expect(client.addUrl(options)).rejects.toThrow();
    });
  });
  
  describe('getStatus', () => {
    it('should get torrent status', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createTransmissionClient(config);
      const testTorrent = createTestTorrent();
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/transmission/rpc`, (req, res, ctx) => {
          return res(
            ctx.status(HttpStatus.OK),
            ctx.json(createTransmissionResponse({
              torrents: [testTorrent]
            }))
          );
        })
      );
      
      // Act
      const result = await client.getStatus(TEST_TORRENT_ID.toString());
      
      // Assert
      expect(result.id).toBe(TEST_TORRENT_ID.toString());
      expect(result.name).toBe(TEST_TORRENT_NAME);
      expect(result.status).toBe(DownloadStatus.DOWNLOADING);
      expect(result.progress).toBe(35); // 0.35 -> 35%
      expect(result.downloadSpeed).toBe(1024000);
      expect(result.uploadSpeed).toBe(51200);
    });
    
    it('should include additional fields when requested', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createTransmissionClient(config);
      const testTorrent = createTestTorrent();
      testTorrent.files = [
        { name: 'test.mkv', length: 2147483648, bytesCompleted: 751619276 }
      ];
      testTorrent.fileStats = [
        { bytesCompleted: 751619276, wanted: true, priority: 0 }
      ];
      testTorrent.peers = [
        { 
          address: '192.168.1.1', 
          clientName: 'qBittorrent 4.4.0', 
          rateToClient: 512000, 
          rateToPeer: 51200, 
          progress: 1.0 
        }
      ];
      testTorrent.trackers = [
        { 
          announce: 'https://example.com/announce', 
          id: 1, 
          scrape: 'https://example.com/scrape', 
          tier: 0 
        }
      ];
      
      const options: GetStatusOptions = {
        includeFiles: true,
        includePeers: true,
        includeTrackers: true
      };
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/transmission/rpc`, (req, res, ctx) => {
          return res(
            ctx.status(HttpStatus.OK),
            ctx.json(createTransmissionResponse({
              torrents: [testTorrent]
            }))
          );
        })
      );
      
      // Act
      const result = await client.getStatus(TEST_TORRENT_ID.toString(), options);
      
      // Assert
      expect(result.id).toBe(TEST_TORRENT_ID.toString());
      expect(result.name).toBe(TEST_TORRENT_NAME);
      expect(result.clientSpecific?.files).toHaveLength(1);
      expect(result.clientSpecific?.fileStats).toHaveLength(1);
      expect(result.clientSpecific?.peers).toHaveLength(1);
      expect(result.clientSpecific?.trackers).toHaveLength(1);
    });
    
    it('should handle torrent not found', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createTransmissionClient(config);
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/transmission/rpc`, (req, res, ctx) => {
          return res(
            ctx.status(HttpStatus.OK),
            ctx.json(createTransmissionResponse({
              torrents: []
            }))
          );
        })
      );
      
      // Act & Assert
      await expect(client.getStatus('999')).rejects.toThrow('Torrent with ID 999 not found');
    });
  });
  
  describe('getAllItems', () => {
    it('should get all torrents', async () => {
      // Arrange
      const config = createTestConfig();
      const client = createTransmissionClient(config);
      const testTorrent1 = createTestTorrent();
      const testTorrent2 = createCompletedTorrent();
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/transmission/rpc`, (req, res, ctx) => {
          return res(
            ctx.status(HttpStatus.OK),
            ctx.json(createTransmissionResponse({
              torrents: [testTorrent1, testTorrent2]
            }))
