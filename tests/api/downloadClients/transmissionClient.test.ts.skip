  describe('mapStatus', () => {
    it('should map Transmission status to DownloadStatus', async () => {
      // Arrange
      const config = createTestConfig();
      const client = new TransmissionClient(config);
      
      // Create test data with different statuses
      const stoppedTorrent = createTestTorrent();
      stoppedTorrent.status = 0; // Stopped
      
      const checkWaitTorrent = createTestTorrent();
      checkWaitTorrent.status = 1; // Check waiting
      
      const checkingTorrent = createTestTorrent();
      checkingTorrent.status = 2; // Checking
      
      const downloadWaitTorrent = createTestTorrent();
      downloadWaitTorrent.status = 3; // Download waiting
      
      const downloadingTorrent = createTestTorrent();
      downloadingTorrent.status = 4; // Downloading
      
      const seedWaitTorrent = createTestTorrent();
      seedWaitTorrent.status = 5; // Seed waiting
      
      const seedingTorrent = createTestTorrent();
      seedingTorrent.status = 6; // Seeding
      
      // Setup mock response
      server.use(
        rest.post(`${TEST_BASE_URL}/transmission/rpc`, (req, res, ctx) => {
          return res(
            ctx.status(HttpStatus.OK),
            ctx.json(createTransmissionResponse({
              torrents: [
                stoppedTorrent,
                checkWaitTorrent,
                checkingTorrent,
                downloadWaitTorrent,
                downloadingTorrent,
                seedWaitTorrent,
                seedingTorrent
              ]
            }))
          );
        })
      );
      
      // Act
      const items = await client.getAllItems();
      
      // Assert
      expect(items[0].status).toBe(DownloadStatus.PAUSED);
      expect(items[1].status).toBe(DownloadStatus.QUEUED);
      expect(items[2].status).toBe(DownloadStatus.QUEUED);
      expect(items[3].status).toBe(DownloadStatus.QUEUED);
      expect(items[4].status).toBe(DownloadStatus.DOWNLOADING);
      expect(items[5].status).toBe(DownloadStatus.COMPLETED);
      expect(items[6].status).toBe(DownloadStatus.COMPLETED);
    });
  });
  
  describe('proxy mode', () => {
    it('should use proxy endpoint in proxy mode', async () => {
      // Arrange
      const config = createTestConfig({ proxyMode: true });
